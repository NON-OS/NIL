# Copy to .env and adjust. Every setting is optional.

# Port the server listens on.
PORT=3000

# Where the SQLite database and uploaded files live. Back this folder up.
DATA_DIR=./data

# Set this when NONOS runs behind a reverse proxy (Caddy, Nginx, Traefik, a PaaS).
# "1" trusts one proxy hop, which is right for most setups. Needed for secure cookies and correct client IPs.
# TRUST_PROXY=1

# Your public address, e.g. https://tasks.yourcompany.com. Used for origin checks.
# APP_URL=https://tasks.example.com

# How long a sign-in lasts, in days.
# SESSION_DAYS=30

# Days a deleted task stays in the trash before it is erased for good.
# TRASH_DAYS=30

# Largest file upload, in megabytes.
# MAX_UPLOAD_MB=25

# Largest encrypted capsule accepted when restoring, in megabytes.
# MAX_CAPSULE_MB=4096

# Where people can get this server's source code. The AGPL asks you to offer it
# if you run a modified version for others. Shown in the app's account menu.
# SOURCE_URL=https://github.com/you/nonos

# AI assist (optional). Leave unset and no task data ever leaves your server.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
