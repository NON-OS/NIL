# App settings every hosted workspace shares. On the server: /opt/nil/workspace.env.
#
# Same format as the app's .env (see the root .env.example for every setting). The control
# plane sets APP_URL, TRUST_PROXY, PLAN_TREASURY, SOURCE_URL, NOX_RPC_URL and SETUP_TOKEN for
# each workspace itself and ignores them here, as it does DATA_DIR, DB_FILE, PORT and HOST.
# Changes reach a workspace when its container is next created. To apply them to all of them,
# one at a time:  docker compose exec control node cli.js refresh --all

# The Nil Pro subscription, billed inside each workspace to CLOUD_PLAN_TREASURY.
PLAN_PRICE=1000
PLAN_PERIOD_DAYS=30
PLAN_GRACE_DAYS=7
PLAN_FREE_SEATS=5
PLAN_TRIAL_DAYS=14

# Leave the Anthropic key out: with CLOUD_EGRESS=rpc-only a workspace can't reach Anthropic
# anyway, and hosted workspaces then never send text to an AI provider.
# ANTHROPIC_API_KEY=
