{
  "name": "nonos",
  "version": "3.0.0",
  "private": true,
  "description": "NØNOS: a self-hosted team workspace with wallet-only sign-in, end-to-end encrypted docs, bounties and votes in NOX, and signed proof of work.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "check:quality": "node scripts/check-quality.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --import ./scripts/test/registerTs.mjs --test server/test/*.test.js client/test/*.test.js client/test/*.test.ts",
    "release:manifest": "node scripts/release/manifest.mjs",
    "verify:server": "node scripts/release/verify.mjs",
    "zk:fetch": "node scripts/zk-fetch.mjs",
    "zk:ballot": "node scripts/zk-ballot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "@zk-kit/baby-jubjub": "1.0.3",
    "express": "4.22.3",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.5",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.1.0",
    "@semaphore-protocol/identity": "4.14.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "@zk-kit/binary-merkle-root.circom": "2.0.0",
    "@zk-kit/utils": "1.3.0",
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "concurrently": "9.1.0",
    "lucide-react": "0.460.0",
    "pptxgenjs": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  },
  "license": "AGPL-3.0-or-later",
  "overrides": {
    "ws": "8.22.0",
    "snarkjs": "0.7.5",
    "underscore": "1.13.8",
    "image-size": "2.0.4"
  }
}
