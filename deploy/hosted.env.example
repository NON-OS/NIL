# /opt/nil/.env for hosted Nil: image versions and host settings, read by Docker Compose and
# the deploy scripts. provision.sh creates it from this file and fills in NIL_MODE, DOCKER_GID
# and NIL_BACKUP_DIR; install.sh sets NIL_VERSION on the first release; upgrade.sh and
# rollback.sh keep NIL_VERSION and NIL_PREVIOUS_VERSION up to date. Control plane settings go
# in cloud.env, app settings shared by every workspace in workspace.env.

NIL_MODE=hosted

# The release every workspace and the control plane run. Changed by upgrade.sh and rollback.sh.
NIL_VERSION=
NIL_PREVIOUS_VERSION=

# Image names, as release.sh tagged them (or as your registry has them).
NIL_IMAGE=nonos/nil
NIL_CLOUD_IMAGE=nonos/nil-cloud

# Caddy. The stock image is enough for on-demand TLS; for CLOUD_TLS=wildcard use an image built
# with your DNS provider's module (cloud/caddy/Dockerfile, or release.sh --caddy-dns-module) and
# give it the provider's API token.
CADDY_IMAGE=caddy:2.10.2
DNS_API_TOKEN=

# The docker group's id on this server, so the control plane can use the Docker socket.
DOCKER_GID=

# Where the backup share (a Hetzner Storage Box, say) is mounted on this server. Mounted into
# the control plane as /backups: use CLOUD_BACKUP_TARGET=file:///backups in cloud.env.
NIL_BACKUP_DIR=/mnt/nil-backups

# The optional Ethereum node (docker-compose.chain.yml). To run it, uncomment COMPOSE_FILE, set
# both images to the current stable release tags (github.com/paradigmxyz/reth/releases and
# github.com/sigp/lighthouse/releases; an outdated client stops following the chain at the next
# network upgrade), and set CLOUD_RPC_URL=http://reth:8545 in cloud.env.
# COMPOSE_FILE=docker-compose.yml:docker-compose.chain.yml
RETH_IMAGE=
LIGHTHOUSE_IMAGE=
