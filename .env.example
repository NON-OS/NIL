# NØNOS settings. Copy this file to .env and adjust it.
#
# Every setting is optional. A commented-out line shows the default that applies when the
# variable is not set. Uncomment a line only to change it.
#
# Docker Compose reads .env automatically (docker-compose.yml lists it as env_file).
# Plain Node does not: start with  node --env-file=.env --disable-warning=ExperimentalWarning server/index.js
#
# Keep comments on their own lines. An empty value counts as unset, so the default applies.
# A number, PLAN_TREASURY, PLAN_PRICE or NOX_EXPLORER that the server can't use is named in a
# "[config]" warning in the startup log, which also says what the server does instead.
# Never commit your real .env.


# ---------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------

# Your public address, with no trailing slash, e.g. https://nonos.example.com.
# Used in wallet sign-in messages (wallets show this domain), origin checks, and the links in
# the public bounty feed. Set it in production. Empty is safe (local use).
APP_URL=

# Set to 1 when NØNOS runs behind one reverse proxy (Caddy, Nginx, Traefik, a PaaS). It trusts
# one proxy hop, which is right for most setups. Without it, cookies lose the Secure flag and
# __Host- prefix, HSTS is not sent, and rate limits see the proxy's IP instead of the visitor's.
# Accepts 1 (or another whole number of hops), true, or an Express trust-proxy value.
# Leave it empty when nothing sits in front of NØNOS (for example onion-only over Tor).
TRUST_PROXY=

# Where people can get this server's source code. The AGPL asks you to offer it if you run a
# modified version for others. Shown in the app (account menu and Settings → Data & privacy).
# Empty is safe.
SOURCE_URL=

# Port the server listens on.
# PORT=3000

# Interface the server binds to. Keep 0.0.0.0 in Docker. With plain Node behind a proxy on the
# same machine, 127.0.0.1 keeps the port off the network.
# HOST=0.0.0.0

# Folder for the database, uploaded files and the receipt signing key (keys/). Back it up.
# The Docker image sets /data, which is the nonos-data volume. Don't set this in Docker,
# or the data ends up outside the volume.
# DATA_DIR=./data

# Full path of the SQLite database file, if it should live outside DATA_DIR.
# Uploads and keys stay in DATA_DIR either way. Default: DATA_DIR/nonos.db
# DB_FILE=

# Extra origins allowed to make changes, open the live connection and call /mcp, comma separated,
# e.g. https://nonos.example.com,http://abcdef.onion. APP_URL is always allowed. The address the
# browser is on (the Host header) is allowed too, so most setups need nothing here.
# ALLOWED_ORIGINS=


# ---------------------------------------------------------------------------------------------
# Sessions, uploads and retention
# ---------------------------------------------------------------------------------------------

# How long a sign-in lasts, in days.
# SESSION_DAYS=30

# Days a deleted task stays in the trash before it is erased for good.
# TRASH_DAYS=30

# Largest file attachment, in whole megabytes.
# MAX_UPLOAD_MB=25

# Largest encrypted capsule accepted when restoring a workspace, in whole megabytes.
# MAX_CAPSULE_MB=4096


# ---------------------------------------------------------------------------------------------
# Ethereum and NOX
# ---------------------------------------------------------------------------------------------

# Ethereum JSON-RPC node used to check payments, balances, stakes and passes, and to relay
# private-payout transactions. The node sees which addresses and transactions this server looks
# up, and this server's IP. Point it at your own node, or a provider you trust, for privacy.
# The server refuses a node whose chain ID differs from NOX_CHAIN_ID.
# "off" turns every on-chain feature off: bounty payments, private payouts, the token-holder
# door, weighted votes and the subscription (the server then runs in community mode).
# NOX_RPC_URL=https://ethereum-rpc.publicnode.com

# Chain ID of the network NOX lives on. 1 is Ethereum mainnet.
# NOX_CHAIN_ID=1

# NOX token contract address.
# NOX_TOKEN=0x0a26c80be4e060e688d7c23addb92cbb5d2c9eca

# Token symbol and decimals, as shown in the app.
# NOX_SYMBOL=NOX
# NOX_DECIMALS=18

# Blocks a payment needs on top of it before it counts (bounties and subscription payments).
# NOX_CONFIRMATIONS=3

# Block explorer used for transaction and address links in the app, as an http or https address.
# Links open only when clicked. The proof verifier links a payment receipt to it only when the
# receipt's chain is NOX_CHAIN_ID.
# NOX_EXPLORER=https://etherscan.io


# ---------------------------------------------------------------------------------------------
# Bounty reward tokens
# ---------------------------------------------------------------------------------------------

# Tokens bounties can be paid in besides NOX, as SYMBOL:address:decimals, comma separated.
# NOX is always first and can't be removed. Entries with a bad address are ignored.
# The default is USDC on Ethereum mainnet: change it if NOX_CHAIN_ID is not 1.
# Set to "none" to pay bounties in NOX only. Empty means the default, not "none".
# REWARD_TOKENS=USDC:0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48:6


# ---------------------------------------------------------------------------------------------
# NOX subscription (optional)
# ---------------------------------------------------------------------------------------------
# With PLAN_TREASURY unset, the server runs in community mode: every tool is unlocked and
# nothing is charged. That is the normal choice for self-hosting. Set a treasury only if you run
# NØNOS for others and want each workspace to pay you in NOX.

# Address that receives subscription payments. It must be a valid 0x address. Anything else is
# ignored with a startup warning, and the server stays in community mode.
# PLAN_TREASURY=

# Price per period, in whole NOX (decimals allowed, e.g. 12.5).
# Zero or an invalid value falls back to 1000, with a startup warning.
# PLAN_PRICE=1000

# Length of one paid period, in days.
# PLAN_PERIOD_DAYS=30

# Days the paid tools keep working after a subscription lapses.
# PLAN_GRACE_DAYS=7

# People (not counting guests) a workspace can have without an active subscription.
# PLAN_FREE_SEATS=5

# Most periods one payment can buy. Anything paid beyond this in a single transaction is not credited.
# PLAN_MAX_PERIODS=24

# Free trial, in days, counted from the day the workspace was set up (not from when you set
# PLAN_TREASURY). 0 means no trial.
# PLAN_TRIAL_DAYS=14


# ---------------------------------------------------------------------------------------------
# Private payouts (ERC-5564 stealth addresses)
# ---------------------------------------------------------------------------------------------

# ERC-5564 announcer contract. The default is the standard's singleton, the same address on
# every chain it is deployed to.
# STEALTH_ANNOUNCER=0x55649E01B5Df198D18D95b5cc5051630cfD45564

# ETH, in wei, the payer sends along with each private payout so the contributor can pay gas
# from the one-time address. Default 300000000000000 wei = 0.0003 ETH. Digits only.
# STEALTH_GAS_TOPUP_WEI=300000000000000

# How many days a confirmed private payout keeps being checked for a late announcement.
# STEALTH_ANNOUNCE_CHECK_DAYS=7


# ---------------------------------------------------------------------------------------------
# Voting power
# ---------------------------------------------------------------------------------------------
# Power = NOX in linked wallets + NOX staked + Zero-State Passes (ZSPs) × power per ZSP,
# read at one block when a weighted vote opens.

# Staking contract read with getStakeInfo(address). "off" leaves staked NOX out.
# NOX_STAKING=0xa94d6009790Ba13597A1E1b7cF4e1531eA513613

# Zero-State Pass contract read with balanceOf(address). "off" leaves ZSPs out.
# ZSP_CONTRACT=0x7b575dd8e8b111c52ab1e872924d4efd4df403df

# Default voting power per ZSP, in whole NOX. Admins can change it per workspace in
# Settings → Team → Voting power. Digits only.
# VOTE_ZSP_POWER=100000


# ---------------------------------------------------------------------------------------------
# Anonymous votes (Semaphore)
# ---------------------------------------------------------------------------------------------

# Depth of the Semaphore voter tree: up to 2^depth voters per vote (16 = 65,536).
# The browser loads client/public/zk/semaphore-<depth>.wasm and .zkey, and only depth 16 ships.
# To change it, run  SEMAPHORE_DEPTH=<n> npm run zk:fetch  before building (or building the
# Docker image), and change it only while no anonymous vote is open.
# Encrypted weighted votes use their own circuit, which is fixed at depth 16.
# SEMAPHORE_DEPTH=16


# ---------------------------------------------------------------------------------------------
# Built-in AI (optional)
# ---------------------------------------------------------------------------------------------
# Leave these unset and no task data ever goes to Anthropic. With a key set, text goes to
# Anthropic only when someone clicks an AI button. Connecting your own assistant over MCP
# (Settings → Connect AI) works either way and needs no key here.

# Anthropic API key. Setting it turns built-in AI on.
# ANTHROPIC_API_KEY=

# Alternative to the API key: a bearer token for the Anthropic API. Also turns built-in AI on.
# ANTHROPIC_AUTH_TOKEN=

# Model used for built-in AI.
# ANTHROPIC_MODEL=claude-opus-5-5

# The Anthropic SDK also reads ANTHROPIC_BASE_URL, if you need to send requests through another endpoint.
# ANTHROPIC_BASE_URL=


# ---------------------------------------------------------------------------------------------
# Agents (optional)
# ---------------------------------------------------------------------------------------------
# AI teammates added in Settings → Agents. External agents connect over /mcp or the REST API at
# /api/agent/v1 with their own key and need nothing here. Built-in agents run inside Nil, on
# Anthropic (needs ANTHROPIC_API_KEY above) or on an OpenAI-compatible endpoint such as a local
# model. Each limit below is a workspace default; admins can change it per agent.
# See docs/ai-agents.md.

# Model for built-in agents on Anthropic.
# AGENT_MODEL=claude-opus-5-5

# Effort for Anthropic runs: low, medium, high, xhigh or max. "off" leaves it out, for models
# that don't take it.
# AGENT_EFFORT=high

# "off" stops sending the adaptive thinking setting, for older models that reject it.
# AGENT_THINKING=adaptive

# Model turns one run may take before it stops and says so.
# AGENT_MAX_STEPS=12

# Tokens (input and output together) one run may use, and one agent may use per day.
# AGENT_MAX_TOKENS_PER_RUN=300000
# AGENT_MAX_TOKENS_PER_DAY=3000000

# Longest single model answer, in tokens.
# AGENT_MAX_OUTPUT_TOKENS=32000

# Wall-clock limit for one run, in seconds.
# AGENT_RUN_TIMEOUT_SECONDS=600

# Runs at the same time, across all agents.
# AGENT_CONCURRENCY=2

# Retries after a transient model error (rate limit, overloaded or unreachable API).
# AGENT_RETRIES=3

# How often the run queue and the webhook queue are checked, in seconds. New work starts at
# once anyway; this catches retries whose wait is over.
# AGENT_POLL_SECONDS=5

# Where a built-in agent moves assigned work it finished: a status (backlog, todo, in_progress,
# in_review, done, canceled) or "none" to leave it.
# AGENT_DONE_STATUS=in_review

# Requests a minute per agent key on /mcp and /api/agent/v1.
# AGENT_RATE_LIMIT=60

# Hours an Idempotency-Key on the REST API is remembered.
# AGENT_IDEMPOTENCY_HOURS=24

# An agent changing more than this many tasks within the window needs a person's approval.
# AGENT_BULK_LIMIT=5
# AGENT_BULK_WINDOW_MINUTES=10

# Requests one agent may have waiting for approval at a time. Past this, its next request that
# needs approval is refused until people have decided some.
# AGENT_MAX_PENDING_APPROVALS=20

# Lets webhooks and model endpoints use loopback and private addresses (and plain http), for an
# agent or model on your own machine or network, such as Ollama on localhost. Link-local and
# cloud metadata addresses stay blocked. Leave it off on a server others can configure.
# AGENT_ALLOW_LOCAL_ENDPOINTS=false

# Webhook deliveries: how long to wait for an answer, how many attempts per delivery, the first
# retry delay (doubling each time, with jitter), and how many failed attempts in a row switch a
# webhook off.
# AGENT_WEBHOOK_TIMEOUT_SECONDS=10
# AGENT_WEBHOOK_MAX_ATTEMPTS=8
# AGENT_WEBHOOK_BACKOFF_SECONDS=30
# AGENT_WEBHOOK_DISABLE_AFTER=20

# The replay window receivers should apply to Nil-Timestamp, shown in Settings and the docs.
# AGENT_WEBHOOK_TOLERANCE_SECONDS=300

# Hours ahead a task.due_soon webhook is sent for work assigned to an agent.
# AGENT_DUE_SOON_HOURS=24

# Dollars per million input and output tokens, only for the cost estimate in Settings. The
# defaults are Anthropic's list price for the default model; a local model costs 0 unless an
# admin enters prices on the agent.
# AGENT_PRICE_INPUT_PER_MTOK=4
# AGENT_PRICE_OUTPUT_PER_MTOK=20


# ---------------------------------------------------------------------------------------------
# Not read by the server
# ---------------------------------------------------------------------------------------------
# These are used only by development tools and npm scripts, and they don't load .env.
# Set them in your shell when you run the command.
#
#   NONOS_API      npm run dev: where the Vite dev server sends /api and /ws (default http://localhost:3000)
#   PTAU           npm run zk:ballot: path to the Perpetual Powers of Tau file (ppot_0080_16.ptau)
#   BEACON_RPC     npm run zk:ballot: Ethereum node for the beacon block hash (default the public node above)
#   CONTRIBUTORS   npm run zk:ballot: number of phase-2 contributions (default 2, all on this machine)
