# App settings every hosted workspace shares. On the server: /opt/nil/workspace.env.
#
# Same format as the app's .env (see the root .env.example for every setting). The control
# plane sets APP_URL, TRUST_PROXY, PLAN_TREASURY, PLAN_INVOICE_SLOT, PLAN_INVOICE_KEY, SOURCE_URL,
# NOX_RPC_URL, NOX_VERIFIER_KEY, SETUP_TOKEN, UPLOAD_QUOTA_MB and MAX_CAPSULE_MB (the storage
# quota and the largest capsule, both from the workspace's plan) for each workspace itself and
# ignores them here, as it does DATA_DIR, DB_FILE, PORT and HOST.
# Changes reach a workspace when its container is next created. To apply them to all of them,
# one at a time:  docker compose exec control node cli.js refresh --all

# Nil Pro, billed inside each workspace to CLOUD_PLAN_TREASURY, priced in US dollars and paid in
# USDC or NOX (see the root .env.example for every billing setting).
PLAN_PRICE_USD=12
PLAN_SEAT_USD=3
PLAN_PERIOD_DAYS=30
PLAN_GRACE_DAYS=7
PLAN_FREE_SEATS=5
PLAN_TRIAL_DAYS=14
# the trial's own grace days, unset meaning PLAN_GRACE_DAYS; 0 for a short trial that just ends
# PLAN_TRIAL_GRACE_DAYS=0
# room in the amounts' last digits for every workspace's slot (CLOUD_INVOICE_SLOTS)
PLAN_SUFFIX_DIGITS=6
# The NOX price in US dollars while there's no pool to read it from. Without it, invoices are
# USDC only. Keep it current.
# PLAN_NOX_USD=

# Push notifications travel through the browser makers' push services, which a workspace can't
# reach with CLOUD_EGRESS=rpc-only, so they would fail without a word. Off, the app doesn't offer
# them. With CLOUD_EGRESS=open and VAPID keys set, they can be turned on.
PUSH_NOTIFICATIONS=off

# Phone wallets over WalletConnect, for people on a computer without a wallet extension. The
# project ID is public, not a secret: every browser sends it to the relay. One project serves
# every hosted workspace when its allowed domains list the workspaces' domain (a wildcard such
# as *.nil.example covers them). Browsers reach the relay directly, so CLOUD_EGRESS doesn't
# matter here. Empty keeps them off.
WALLETCONNECT_PROJECT_ID=

# Leave the Anthropic key out: with CLOUD_EGRESS=rpc-only a workspace can't reach Anthropic
# anyway, and hosted workspaces then never send text to an AI provider.
# ANTHROPIC_API_KEY=
