# /opt/nil/.env for hosted Nil: image versions and host settings, read by Docker Compose and
# the deploy scripts. provision.sh creates it from this file and fills in NIL_MODE, DOCKER_GID
# and NIL_BACKUP_DIR; install.sh sets NIL_VERSION on the first release; upgrade.sh and
# rollback.sh keep NIL_VERSION and NIL_PREVIOUS_VERSION up to date. Control plane settings go
# in cloud.env, app settings shared by every workspace in workspace.env.

NIL_MODE=hosted

# The release every workspace and the control plane run. Changed by upgrade.sh and rollback.sh.
NIL_VERSION=
NIL_PREVIOUS_VERSION=

# Image names, as release.sh tagged them (or as your registry has them).
NIL_IMAGE=nonos/nil
NIL_CLOUD_IMAGE=nonos/nil-cloud

# Caddy. The stock image is enough for on-demand TLS; for CLOUD_TLS=wildcard use an image built
# with your DNS provider's module (cloud/caddy/Dockerfile, or release.sh --caddy-dns-module) and
# give it the provider's API token.
CADDY_IMAGE=caddy:2.10.2
DNS_API_TOKEN=

# The docker group's id on this server, so the control plane can use the Docker socket.
DOCKER_GID=

# Where the backup share (a Hetzner Storage Box, say) is mounted on this server. Mounted into
# the control plane as /backups: use CLOUD_BACKUP_TARGET=file:///backups in cloud.env.
NIL_BACKUP_DIR=/mnt/nil-backups

# Nil's verifier (docker-compose.verifier.yml) and the optional Ethereum node
# (docker-compose.chain.yml). At launch the verifier runs in shadow mode (CLOUD_VERIFIER_MODE and
# CLOUD_VERIFIER_URL in cloud.env): workspaces act on CLOUD_RPC_URL as before, and the verifier
# catches a node that lies. Without VERIFIER_KEY it stays off. For the node, also set both images
# to the current stable release tags
# (github.com/paradigmxyz/reth/releases and github.com/sigp/lighthouse/releases; an outdated
# client stops following the chain at the next network upgrade).
# COMPOSE_FILE=docker-compose.yml:docker-compose.chain.yml:docker-compose.verifier.yml
# Without the node: COMPOSE_FILE=docker-compose.yml:docker-compose.verifier.yml
RETH_IMAGE=
LIGHTHOUSE_IMAGE=

# The verifier's key. Make it with: openssl rand -hex 32. The control plane hands it to every
# workspace; changing it, or CLOUD_VERIFIER_MODE, needs `node cli.js refresh --all` afterwards.
VERIFIER_KEY=
# The root of a finalized beacon block less than two weeks old, the light client's starting
# point and what it trusts. Take it from two beacon APIs run by different people that agree
# (one of them can be your own Lighthouse), for example
#   curl -s https://ethereum-beacon-api.publicnode.com/eth/v1/beacon/headers/finalized | jq -r .data.root
#   curl -s https://lodestar-mainnet.chainsafe.io/eth/v1/beacon/headers/finalized | jq -r .data.root
# (right after a new epoch is finalized they can differ for a minute; ask again)
# After the first start the verifier keeps the newest one it reached, so this only matters again
# when it has been stopped for close to two weeks.
VERIFIER_CHECKPOINT=
# Without the bundled node: the execution node (it must answer eth_getProof for recent blocks)
# and a beacon API with the light-client endpoints. Both default to the bundled node.
# VERIFIER_EXECUTION_RPC=
# VERIFIER_CONSENSUS_RPC=
