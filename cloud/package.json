{
  "name": "nil-cloud",
  "version": "4.0.0",
  "private": true,
  "description": "Control plane for hosted Nil: one isolated container per workspace, wallet sign-up, routing, backups and health checks.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning index.js",
    "pretest": "npm run build:phone",
    "test": "node --disable-warning=ExperimentalWarning --test test/",
    "build:phone": "node scripts/buildPhone.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.1.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@walletconnect/sign-client": "2.25.0",
    "esbuild": "0.28.2",
    "ws": "8.22.0"
  },
  "overrides": {
    "ws": "8.22.0",
    "ox": {
      "@noble/curves": "1.9.7"
    }
  },
  "license": "BUSL-1.1"
}
