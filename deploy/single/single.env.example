# /opt/nil/.env for one self-hosted Nil workspace behind Caddy: versions and host settings for
# Docker Compose and the deploy scripts. The app's own settings go in nil.env (the root
# .env.example, explained line by line). provision.sh creates this file and fills in NIL_MODE;
# install.sh sets NIL_VERSION on the first release; upgrade.sh and rollback.sh keep it current.

NIL_MODE=single

# The release that runs. Changed by upgrade.sh and rollback.sh.
NIL_VERSION=
NIL_PREVIOUS_VERSION=

# The address people type, without https://. Point its A and AAAA records at this server.
NIL_DOMAIN=

# For Let's Encrypt and ZeroSSL expiry notices.
ACME_EMAIL=

# The app image as release.sh tagged it. localhost/ keeps it off Docker Hub: it is never pulled.
NIL_IMAGE=localhost/nonos/nil
# pinned by digest, so the server runs exactly the image that was reviewed
CADDY_IMAGE=caddy:2.10.2@sha256:c3d7ee5d2b11f9dc54f947f68a734c84e9c9666c92c88a7f30b9cba5da182adb

# Memory limit for the app's container.
NIL_MEMORY=2g

# Filled in by provision.sh; not used in single mode.
DOCKER_GID=
