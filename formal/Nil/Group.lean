/-!
An additive commutative group with integer scalars, stated as the laws the proofs use and
nothing else. Baby Jubjub's prime-order subgroup (generated by Base8) and secp256k1's group are
both such groups, with scalar multiplication being repeated point addition.
-/

namespace Nil

class IntGroup (G : Type) extends Add G, Zero G, Neg G where
  smul : Int → G → G
  add_assoc : ∀ a b c : G, a + b + c = a + (b + c)
  add_comm : ∀ a b : G, a + b = b + a
  add_zero : ∀ a : G, a + 0 = a
  add_neg : ∀ a : G, a + -a = 0
  smul_add : ∀ (n : Int) (a b : G), smul n (a + b) = smul n a + smul n b
  add_smul : ∀ (m n : Int) (a : G), smul (m + n) a = smul m a + smul n a
  mul_smul : ∀ (m n : Int) (a : G), smul (m * n) a = smul m (smul n a)
  one_smul : ∀ a : G, smul 1 a = a

namespace IntGroup

variable {G : Type} [IntGroup G]

infixr:73 " • " => IntGroup.smul

instance : Sub G := ⟨fun a b => a + -b⟩

theorem sub_def (a b : G) : a - b = a + -b := rfl

theorem zero_add (a : G) : 0 + a = a := by rw [add_comm, add_zero]

theorem add_left_cancel {a b c : G} (h : a + b = a + c) : b = c := by
  have : -a + (a + b) = -a + (a + c) := by rw [h]
  rwa [← add_assoc, ← add_assoc, add_comm (-a) a, add_neg, zero_add, zero_add] at this

theorem eq_zero_of_add_self {a b : G} (h : a + b = a) : b = 0 := by
  apply add_left_cancel (a := a); rw [h, add_zero]

theorem neg_unique {a b : G} (h : a + b = 0) : b = -a := by
  apply add_left_cancel (a := a); rw [h, add_neg]

theorem zero_smul (a : G) : (0 : Int) • a = 0 := by
  apply eq_zero_of_add_self (a := (0 : Int) • a)
  rw [← add_smul]; rfl

theorem smul_zero (n : Int) : n • (0 : G) = 0 := by
  apply eq_zero_of_add_self (a := n • (0 : G))
  rw [← smul_add, add_zero]

theorem neg_smul (n : Int) (a : G) : (-n) • a = -(n • a) := by
  apply neg_unique; rw [← add_smul, Int.add_right_neg, zero_smul]

theorem sub_smul (m n : Int) (a : G) : (m - n) • a = m • a - n • a := by
  rw [Int.sub_eq_add_neg, add_smul, neg_smul]; rfl

theorem add_sub_cancel (a b : G) : a + b - b = a := by
  rw [sub_def, add_assoc, add_neg, add_zero]

theorem add_add_add_comm (a b c d : G) : a + b + (c + d) = a + c + (b + d) := by
  rw [add_assoc, ← add_assoc b, add_comm b c, add_assoc, ← add_assoc]

end IntGroup

open IntGroup

/-- A group whose every element is killed by the prime `q`, with a generator of order exactly
`q`. Baby Jubjub's subgroup of order `subOrder` with generator Base8 is one; so is secp256k1
with its order `n` and base point. Primality is stated as Euclid's property. -/
structure PrimeOrder (G : Type) [IntGroup G] where
  q : Int
  gen : G
  one_lt : 1 < q
  prime : ∀ a b : Int, q ∣ a * b → q ∣ a ∨ q ∣ b
  kills : ∀ g : G, q • g = 0
  gen_order : ∀ k : Int, k • gen = 0 → q ∣ k

namespace PrimeOrder

variable {G : Type} [IntGroup G] (P : PrimeOrder G)

/-- Scalars only matter modulo `q`. -/
theorem smul_congr {m n : Int} (h : P.q ∣ m - n) (g : G) : m • g = n • g := by
  obtain ⟨k, hk⟩ := h
  have : m = n + k * P.q := by rw [Int.mul_comm]; omega
  rw [this, add_smul, mul_smul, P.kills, smul_zero, add_zero]

theorem smul_emod (m : Int) (g : G) : (m % P.q) • g = m • g := by
  apply P.smul_congr
  exact ⟨-(m / P.q), by rw [Int.emod_def]; grind⟩

/-- Two multiples of the generator agree exactly when their scalars agree modulo `q`. -/
theorem gen_smul_eq_iff (m n : Int) : m • P.gen = n • P.gen ↔ P.q ∣ m - n := by
  constructor
  · intro h
    apply P.gen_order
    rw [sub_smul, h, sub_def, add_neg]
  · intro h; exact P.smul_congr h _

theorem eq_of_dvd_of_range {m n : Int} (h : P.q ∣ m - n) (hm : 0 ≤ m) (hm' : m < P.q)
    (hn : 0 ≤ n) (hn' : n < P.q) : m = n := by
  obtain ⟨k, hk⟩ := h
  have : k = 0 := by
    rcases Int.lt_trichotomy k 0 with h | h | h
    · have : P.q * k ≤ P.q * (-1) := Int.mul_le_mul_of_nonneg_left (by omega) (by have := P.one_lt; omega)
      omega
    · exact h
    · have : P.q * 1 ≤ P.q * k := Int.mul_le_mul_of_nonneg_left (by omega) (by have := P.one_lt; omega)
      omega
  subst this; omega

end PrimeOrder

end Nil
