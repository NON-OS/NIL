# NØNOS settings. Copy this file to .env and adjust it.
#
# APP_URL is required, and so is NOX_RPC_URL on any server people reach over the network.
# Everything else is optional. A commented-out line shows the default that applies when the
# variable is not set. Uncomment a line only to change it.
#
# Docker Compose reads .env automatically (docker-compose.yml lists it as env_file).
# Plain Node does not: start with  node --env-file=.env --disable-warning=ExperimentalWarning server/index.js
#
# Keep comments on their own lines. An empty value counts as unset, so the default applies.
# A number, an address, a price or NOX_EXPLORER that the server can't use is named in a
# "[config]" warning in the startup log, which also says what the server does instead. With
# STRICT_CONFIG=1 any such warning stops the server instead.
# Addresses can be all lower case, or mixed case with a correct EIP-55 checksum.
# Never commit your real .env.


# ---------------------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------------------

# Required. The address people type, with no path, e.g. https://nonos.example.com.
# Wallet sign-in messages name this domain, and only this origin (plus ALLOWED_ORIGINS) may make
# changes. The server never takes it from request headers, so a phishing site can't get a sign-in
# message with its own domain in it. It must be https://, except for http://localhost (this
# machine) and http://<address>.onion (Tor). Without it the server refuses to start.
# The value below is for trying NØNOS on this machine. Change it before anyone else uses it.
# With npm run dev, use http://localhost:5173.
APP_URL=http://localhost:3000

# Which proxy in front of NØNOS may report the visitor's address and protocol (X-Forwarded-*).
# Either the proxy's address or subnet, comma separated (loopback, uniquelocal, 172.18.0.0/16,
# 10.0.0.2), or a number of proxy hops. An address is safer: with a hop count, anyone who reaches
# the port directly can claim any IP and slip past the rate limits, so use one only when the port
# is closed to everything but the proxy. "true" (trust everyone) is refused.
# Caddy in the same Compose project: uniquelocal. A proxy on the same machine as plain Node:
# loopback. Without it, cookies lose the Secure flag and __Host- prefix, HSTS is not sent, and
# rate limits see the proxy's IP instead of the visitor's.
# Leave it empty when nothing sits in front of NØNOS (for example onion-only over Tor).
# In production, an https APP_URL with TRUST_PROXY empty is named in a startup warning.
TRUST_PROXY=

# Where people can read the source code this server runs. Shown in the app (account menu and
# Settings → Data & privacy). Empty hides the link.
SOURCE_URL=

# One-time token that claims a fresh server: the setup and restore screens ask for it, and it
# stops working once a workspace exists. Leave it unset and the server makes one at first start,
# prints it once in the log and keeps it in DATA_DIR/setup-token until the workspace exists.
# If you set it, use 16 to 200 printable characters with no spaces, and remove it afterwards.
# SETUP_TOKEN=

# Port the server listens on.
# PORT=3000

# Interface the server binds to. Keep 0.0.0.0 in Docker. With plain Node behind a proxy on the
# same machine, 127.0.0.1 keeps the port off the network.
# HOST=0.0.0.0

# Folder for the database, uploaded files and the receipt signing key (keys/). Back it up.
# The Docker image sets /data, which is the nonos-data volume. Don't set this in Docker,
# or the data ends up outside the volume.
# DATA_DIR=./data

# Full path of the SQLite database file, if it should live outside DATA_DIR.
# Uploads and keys stay in DATA_DIR either way. Default: DATA_DIR/nonos.db
# DB_FILE=

# Size, in whole megabytes, the database's write-ahead log is cut back to after a checkpoint,
# so one burst of writes doesn't leave a large file behind for good.
# DB_JOURNAL_LIMIT_MB=64

# Milliseconds a write waits for another connection to the database, such as a backup that is
# reading it, before it gives up with "database is locked".
# DB_BUSY_TIMEOUT_MS=5000

# Milliseconds folding the write-ahead log into the database waits for readers after something
# was erased. The server answers nothing while it waits, so this stays short. A checkpoint that
# can't finish is logged, and the next one tries again.
# DB_CHECKPOINT_WAIT_MS=250

# How many prepared database statements are kept for reuse. Requests that change only some
# fields build their SQL from those fields, so without a cap the cache would keep growing.
# DB_STATEMENT_CACHE=1000

# Extra origins allowed to make changes, open the live connection and call /mcp, comma separated,
# e.g. http://abcdef.onion next to an HTTPS APP_URL. APP_URL is always allowed, and nothing else
# is: the Host header doesn't count. Visitors on one of these origins see it in their wallet's
# sign-in message.
# ALLOWED_ORIGINS=

# Set to 1 to refuse to start while any "[config]" warning remains, instead of carrying on with
# the defaults. Good for production, where a typo should stop a deploy rather than change behaviour.
# STRICT_CONFIG=

# Log format: "text" (one readable line per event) or "json" (one JSON object per line, for log
# collectors). Logs carry times, levels and what happened, never request bodies, cookies or
# secrets from this file.
# LOG_FORMAT=text

# Seconds the server gets to stop cleanly on SIGTERM or Ctrl+C: open requests finish, open tabs
# are told to reconnect, running jobs end and the database is closed. Past this it exits with an
# error. Keep it below Docker's stop_grace_period (30 s in docker-compose.yml).
# SHUTDOWN_TIMEOUT_SECONDS=20


# ---------------------------------------------------------------------------------------------
# Sessions, uploads and retention
# ---------------------------------------------------------------------------------------------

# How long a sign-in lasts, in days.
# SESSION_DAYS=30

# Seconds Nil waits for the Ethereum node when it checks a smart-contract wallet's signature at
# sign-in. Plain wallets are checked without the node.
# SIGNIN_CHAIN_TIMEOUT_SECONDS=8

# Hours a "Reset sign-in" link from Settings → Team stays usable. Each link works once.
# SIGNIN_RESET_HOURS=24

# Hours a reset of an owner's sign-in waits when no second admin can approve it. Owners and admins
# are told and can cancel it meanwhile. Admins who lost the role within this time still count
# toward needing approval, and only admins of at least this long can approve.
# SIGNIN_OWNER_RESET_WAIT_HOURS=72

# Minutes a confirming signature from an already linked wallet stays good for. Linking another
# wallet and making an access key both need one, so a borrowed session alone can't do either.
# SIGNIN_CONFIRM_MINUTES=5

# Days an access key for an AI assistant or script can last at most. Older keys stop working.
# ACCESS_KEY_MAX_DAYS=365

# Days a deleted task stays in the trash before it is erased for good.
# TRASH_DAYS=30

# Days a notification is kept after it was read. Unread ones stay until they are read.
# NOTIFICATION_DAYS=90

# Days a used invite link is kept, so admins can see who joined with it, before it is erased.
# Unused links are erased when they expire.
# USED_INVITE_DAYS=30

# Days a share link or sign-in reset link is kept after it expired, was used or was revoked, an
# API key after it expired, and a bounty payment started in Nil but never sent after it ran out,
# before each is erased. A used reset link stays at least SIGNIN_OWNER_RESET_WAIT_HOURS, since
# approving an owner's reset checks the approver's own sign-in wasn't reset in that time.
# EXPIRED_DAYS=30

# Days a copy of the database taken before an upgrade (pre-migration-*.db in DATA_DIR) is kept.
# Each holds everything the zero-state policies have erased since, so none is kept longer than
# the shortest policy either. The newest three are kept at most.
# UPGRADE_COPY_DAYS=7

# Days after a weighted vote closes (and an encrypted one is decrypted) that the voting power of
# members who didn't vote is kept. The ballots keep the weight they were counted with.
# VOTE_POWER_DAYS=90
# Finished tasks touched within this many days load with the app, up to the newest
# RECENT_CLOSED_MAX of them. Older ones load when a view needs them (All tasks, Calendar,
# Insights, search).
# RECENT_CLOSED_DAYS=30
# RECENT_CLOSED_MAX=1000

# Largest file attachment, in whole megabytes.
# MAX_UPLOAD_MB=25

# Files one person can attach in an hour.
# UPLOADS_PER_HOUR=120

# How much one member (or admin, or owner) can keep in attached files, and one guest, in whole
# megabytes. Guests come from outside the team, bounty applicants among them. Files in the
# trash count until they're erased. 0 turns the quota off.
# UPLOAD_QUOTA_PER_MEMBER_MB=2048
# UPLOAD_QUOTA_PER_GUEST_MB=100

# How much the whole workspace can keep, in whole megabytes: attached files and the database
# together, since docs and comments fill a disk too. Once it's full, new writes are refused and
# reading, deleting and exporting keep working. Memory-only mode (docker-compose.ram.yml) sets
# 768, so nothing can fill the 1 GB data folder. 0 turns it off.
# UPLOAD_QUOTA_MB=20480

# Encrypted files, in Files and inside docs. The largest one file can be, in whole megabytes.
# They count against the same quotas as attached files.
# SEALED_FILE_MAX_MB=2048

# Encrypted uploads one person can start in an hour, and the 1 MB pieces they can send in a
# minute, which caps one person at about 40 MB a second.
# SEALED_UPLOADS_PER_HOUR=600
# SEALED_CHUNKS_PER_MINUTE=2400

# An encrypted upload nobody has added to for this many minutes is deleted, and so is a file
# uploaded to a shared folder that was never added to it.
# SEALED_UPLOAD_STALE_MINUTES=360

# Files and folders one shared folder can hold. Taking someone out of a folder wraps every one of
# their keys again in a single request, and this keeps that request small.
# FOLDER_ITEMS_MAX=5000

# How often the storage in use is measured again, in seconds. Writes in between use the last
# measurement, so the quota can be passed by a few seconds' worth of writes.
# STORAGE_CHECK_SECONDS=10

# Docs saved and comments written per person a minute. The editor saves a version every few
# seconds while someone types, well below this.
# CONTENT_WRITES_PER_MINUTE=120

# Live doc editing. Each change someone makes goes out as an encrypted update, a few a second
# while they type. DOC_UPDATE_MAX_KB caps one update (a bigger paste is saved as a new version
# instead), DOC_PENDING_UPDATES how many a doc collects before the server asks for a version
# that folds them in, and DOC_UPDATES_PER_MINUTE how many one person sends a minute.
# DOC_UPDATE_MAX_KB=512
# DOC_PENDING_UPDATES=1000
# DOC_UPDATES_PER_MINUTE=600

# Versions kept in each doc's history: about one a minute for the last hour, one each quarter
# of an hour for a day, then one a day, up to this many.
# DOC_REVISIONS=100

# Largest encrypted capsule accepted when restoring a workspace, in whole megabytes. A restore
# also needs free disk for twice the capsule, since the upload and its unpacked copy are both
# kept until it's done.
# MAX_CAPSULE_MB=4096

# Largest JSON request body, in whole kilobytes. Uploads and capsules have their own limits above.
# MAX_JSON_KB=1024

# How deep a JSON request body may nest. Deeper bodies are refused before they're read.
# MAX_JSON_DEPTH=64

# Messages one live connection (a browser tab) may send in a minute. The app sends a handful;
# a connection that floods the server is closed and the tab reconnects.
# REALTIME_MESSAGES_PER_MINUTE=600


# ---------------------------------------------------------------------------------------------
# Phone wallets (WalletConnect, optional)
# ---------------------------------------------------------------------------------------------

# Lets people on a computer without a wallet extension scan a code with the wallet app on their
# phone, then sign in, unlock their keys and approve payments on the phone. Get a project ID from
# WalletConnect's dashboard (cloud.reown.com) and list this server's domain under its allowed
# domains. The project ID is public, not a secret: every browser sends it to the relay.
# Empty keeps phone wallets off: the button never shows and the Content-Security-Policy allows
# no relay. When it's set, browsers that use a phone wallet connect to the relay, which carries
# end-to-end encrypted messages and sees their IP addresses and timing (see docs/signing-in.md).
WALLETCONNECT_PROJECT_ID=

# The WalletConnect relay browsers connect to, the one host besides this server the page may
# then reach. A wss:// address with no path.
# WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.org


# ---------------------------------------------------------------------------------------------
# Chat
# ---------------------------------------------------------------------------------------------

# Each conversation's key is replaced at least this often, in days, so a key that leaks opens
# only a stretch of it. The first browser that sends after the time is up starts the new key.
# CHAT_EPOCH_DAYS=7

# Largest encrypted message, in KB, its signature and file keys included.
# CHAT_MESSAGE_KB=64

# Messages, reactions, edits and deletions one person may send a minute, and conversations one
# person may start an hour.
# CHAT_MESSAGES_PER_MINUTE=120
# CHAT_CHANNELS_PER_HOUR=30

# The most people in one channel, and in one group message.
# CHAT_MAX_MEMBERS=500
# CHAT_GROUP_MAX=12

# Messages a page of a conversation loads at a time.
# CHAT_PAGE_SIZE=60

# How far a browser's clock may be from the server's when it sends a message, in seconds.
# CHAT_CLOCK_SKEW_SECONDS=600

# A file sent for a message that never gets posted is removed after this many minutes.
# CHAT_UNPOSTED_FILE_MINUTES=60

# The longest a conversation can keep disappearing messages, in days.
# CHAT_MAX_DISAPPEAR_DAYS=90

# At most one push notification per person and conversation in this many seconds.
# CHAT_PUSH_QUIET_SECONDS=60


# ---------------------------------------------------------------------------------------------
# Background jobs
# ---------------------------------------------------------------------------------------------
# How often each one runs, in seconds. A run that is still going when the next is due is skipped.

# Erasing the trash, expired sessions and invites, and whatever the zero-state policies say.
# Also runs at startup.
# JOB_PURGE_SECONDS=3600

# The purge erases in batches, each its own transaction, and pauses between them so the server
# keeps answering while a large workspace is swept. A stop or restart loses at most the batch in
# progress: the next run carries on from there. Tasks erased per batch (each takes its comments,
# files and history along), rows of everything else per batch, and the pause in milliseconds.
# PURGE_BATCH_TASKS=25
# PURGE_BATCH_ROWS=500
# PURGE_BATCH_PAUSE_MS=10

# Checking pending bounty payments, Nil Pro invoices and private payout announcements on-chain.
# JOB_PAYMENTS_SECONDS=60

# Closing votes whose time is up.
# JOB_VOTES_SECONDS=60

# Turning due reminders into notifications.
# JOB_REMINDERS_SECONDS=60

# Removing disappearing chat messages whose time is up, and chat files nobody posted.
# JOB_CHAT_SWEEP_SECONDS=60

# Sending "Due soon" and "Due today" notes.
# JOB_DUE_ALERTS_SECONDS=60

# Telling agents about their tasks that are coming due.
# JOB_AGENT_DUE_SOON_SECONDS=300

# Erasing old agent run logs, webhook deliveries, audit entries, decided approval cards and
# stored replies past their keep time.
# JOB_AGENT_PRUNE_SECONDS=3600

# Letting SQLite refresh its query planner statistics (PRAGMA optimize). Also runs at startup.
# JOB_OPTIMIZE_SECONDS=3600

# Recording the NOX pool's price for its time-weighted average, when PLAN_NOX_POOL is a Uniswap V2
# pair. Also runs at startup.
# JOB_POOL_PRICE_SECONDS=60

# Reading NOX's fee on transfers between wallets, which its governance can switch on. Admins are
# told while there is one, and payments short by exactly that fee still count. Also runs at startup.
# JOB_TRANSFER_FEE_SECONDS=600

# The billing watchdog, which looks for payments and checks that have stalled (see
# PAYMENT_STALL_HOURS).
# JOB_BILLING_WATCHDOG_SECONDS=300


# ---------------------------------------------------------------------------------------------
# Push notifications, due times and calendar feeds
# ---------------------------------------------------------------------------------------------
# Each person turns push on per device in Settings → Notifications. A notification travels
# through the push service of that browser's maker (Google, Apple, Mozilla, Microsoft),
# encrypted end to end for the device. The push service sees that a message went to the
# device, when, and its padded size, plus this server's address. Private tasks only ever send
# "Reminder" or "A private task is due".

# "off" turns push off for everyone, for example on an onion-only server that should never
# contact a push service. People still get notifications inside the app.
# PUSH_NOTIFICATIONS=on

# The VAPID key pair push services know this server by (RFC 8292), base64url as web-push tools
# print it: the 65-byte public key and the 32-byte private key. Unset, a pair is made on first
# start and kept in DATA_DIR/keys/push-vapid-p256.pem. Changing it makes every device subscribe
# again the next time Nil opens there.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# How a push service can reach whoever runs this server: a mailto: or https: address. Some push
# services, Apple's among them, expect one. Default: APP_URL, when it is https.
# VAPID_SUBJECT=

# Push services the server may deliver to, comma separated. "*." allows any subdomain. The server
# posts nowhere else, so a subscription can't point it at another address.
# PUSH_SERVICES=fcm.googleapis.com,android.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com

# How long a push service keeps trying to deliver to a device that's offline, in hours (0 to 672).
# PUSH_TTL_HOURS=24

# ---------------------------------------------------------------------------------------------
# Calls (docs/calls.md). Audio, video and screens go browser to browser, encrypted end to end;
# none of it passes through Nil. Calls need a TURN relay, so nobody in a call learns anyone
# else's IP address. docker-compose.yml runs one with COMPOSE_PROFILES=calls.
# ---------------------------------------------------------------------------------------------

# "off" turns calls off. They are always off on an .onion address and with docker-compose.tor.yml.
# CALLS=on

# The relay as browsers reach it, comma separated. TLS on 5349 gets through networks that only
# allow HTTPS; plain TURN on 3478 over UDP is quicker where it's allowed.
# TURN_URLS=turns:turn.example.com:5349?transport=tcp,turn:turn.example.com:3478?transport=udp

# The secret Nil and the relay share, at least 32 characters. Make one with
#   openssl rand -hex 32
# and keep it out of git. Nil makes each person's relay password from it.
# TURN_SECRET=

# How long one relay password works, in seconds (60 to 86400). The app fetches a new one well
# before it runs out.
# TURN_TTL_SECONDS=600

# For the relay itself (deploy/coturn): its host name, its public address (and the private one
# behind it, as public/private, when it sits behind NAT), the private address it may still
# relay to in that case, the UDP ports it relays on, where its TLS certificate is, and
# TURN_LOG=on to log connections while something needs looking into.
# TURN_REALM=turn.example.com
# TURN_EXTERNAL_IP=
# TURN_ALLOWED_PEER_IP=
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49999
# TURN_CERT_DIR=/etc/letsencrypt/live/turn.example.com
# TURN_LOG=off

# How many people one call may hold (2 to 8). Everyone sends to everyone, so each one more
# costs everyone upload.
# CALL_MAX_PEERS=6

# How long a call rings before it counts as missed, in seconds.
# CALL_RING_SECONDS=45

# How long someone whose connection to Nil dropped keeps their place in a call, in seconds.
# CALL_REJOIN_SECONDS=30

# Handshake messages one person may send into a call a minute, the largest one in KB, and how
# many calls one person may start a minute.
# CALL_SIGNALS_PER_MINUTE=240
# CALL_SIGNAL_MAX_KB=24
# CALL_STARTS_PER_MINUTE=6

# Minutes before a task's due time that the "Due soon" note goes out.
# DUE_SOON_MINUTES=30

# Hour of the day (0 to 23, on each person's own clock) for the note about tasks due that day
# without a time.
# DUE_DAY_HOUR=9

# "off" turns personal calendar feeds off, and every existing feed link with them.
# CALENDAR_FEEDS=on

# How many times one calendar feed link can be fetched per hour. Calendar apps check every
# 15 minutes to a few hours.
# CALENDAR_FEED_PER_HOUR=30


# ---------------------------------------------------------------------------------------------
# Ethereum and NOX
# ---------------------------------------------------------------------------------------------

# Ethereum JSON-RPC node used to check payments, balances, stakes and passes, and to relay
# private-payout transactions. The node sees which addresses and transactions this server looks
# up, and this server's IP, so it could link wallets and payout addresses to your team.
# Required unless APP_URL is a localhost address: run your own node (an execution client such as
# Geth, Nethermind or Reth, with a consensus client), or use a provider you trust. A localhost
# APP_URL falls back to the public node at ethereum-rpc.publicnode.com, with a startup warning.
# Nil makes the lookups harder to link: private-payout balances are read one address at a time,
# at random moments, with other payees' addresses mixed in, and vote snapshots read wallets in a
# shuffled order a few at a time, so the node can't tell whose wallets go together. It can still
# see that a snapshot's wallets were read together, since they all name one block. Only a node
# you run yourself keeps every lookup to yourself.
# The server refuses a node whose chain ID differs from NOX_CHAIN_ID.
# "off" turns every on-chain feature off: bounty payments, private payouts, the token-holder
# door, weighted votes and Nil Pro (the server then runs in community mode).
NOX_RPC_URL=

# Seconds to wait for the node to answer one request before giving up on it.
# NOX_RPC_TIMEOUT_SECONDS=10

# Verified chain reads, through Nil's verifier (see "Nil's verifier" below).
# off: the server believes NOX_RPC_URL, as it always has.
# shadow: it still acts on NOX_RPC_URL's answers, and checks each one through the verifier at
#   NOX_VERIFIER_URL on the side. An answer the verifier proves false shows admins a notice and
#   writes an error line; one it can't check is only logged. Nothing ever waits on it. Without
#   the key or the URL, shadow is off, with a line in the log saying so.
# enforce: NOX_RPC_URL is the verifier, and the server acts only on answers it proved: payments,
#   invoices, balances, stakes, passes, smart-wallet signatures. When it can't verify, payments
#   wait, votes don't open and nobody joins or is refused through the holder door; admins see why.
#   A lying node can then hide a payment for a while but can't fake one.
# Start in shadow, and switch to enforce once a week of shadow showed no mismatches.
# NOX_VERIFIER_MODE=off

# The key the verifier seals its answers with: the same value as its VERIFIER_KEY, at least 32
# characters (openssl rand -hex 32). Needed for shadow and enforce.
# NOX_VERIFIER_KEY=

# Shadow mode only: where the verifier answers, such as http://verifier:8545.
# NOX_VERIFIER_URL=

# Shadow checks running at once. Past that a read goes unchecked (and logged) rather than queueing.
# NOX_VERIFIER_SHADOW_MAX=8

# Hours admins keep seeing that the node gave an answer that failed its proof, even while later
# answers check out.
# NOX_VERIFY_MISMATCH_HOURS=24

# Chain ID of the network NOX lives on. 1 is Ethereum mainnet.
# The default contract addresses below are mainnet contracts. On any other chain, set NOX_TOKEN,
# NOX_STAKING, ZSP_CONTRACT and REWARD_TOKENS yourself (or "off" / "none" where allowed). One
# that is missing is named in a startup warning, and its feature stays off: without NOX_TOKEN,
# every on-chain feature.
# NOX_CHAIN_ID=1

# NOX token contract address.
# NOX_TOKEN=0x0a26c80be4e060e688d7c23addb92cbb5d2c9eca

# Token symbol and decimals, as shown in the app.
# NOX_SYMBOL=NOX
# NOX_DECIMALS=18

# The highest fee on transfers between wallets the token's governance can set, in basis points
# (300 is NOX's 3%). A higher reading is taken for a misread, and then no payment counts as short
# by a fee.
# NOX_MAX_TRANSFER_FEE_BPS=300

# Payments (bounties, private payouts and Nil Pro) count only once their block is finalized, as
# the node reports with the "finalized" block tag. On a node or chain without that tag, a block
# counts as final this many blocks under the head. Until then each payment's block hash is kept
# and re-checked, so a reorganisation is followed.
# NOX_FINALITY_DEPTH=64

# No longer read: payments wait for a finalized block instead (see NOX_FINALITY_DEPTH).
# NOX_CONFIRMATIONS=3

# Hours a recorded payment waits for its transaction to show up on-chain before it is marked
# failed (bounties), or dropped (a transaction named for a Nil Pro invoice). With
# NOX_VERIFIER_MODE=enforce it is only flagged instead: a light client can't prove a transaction
# doesn't exist, so an admin cancels one that was never sent.
# NOX_MISSING_TX_HOURS=24

# How far under the head, in blocks, your node still answers eth_getLogs. The public node stops
# at 10,000 blocks (about 33 hours); a full node of your own usually answers for all of history,
# so raise this to match it. When the Nil Pro treasury scan falls further behind than this, after
# an outage, the blocks it can no longer read are skipped and the open invoices list them, so an
# admin can paste any transaction sent in that time. Default 10000.
# NOX_LOG_HISTORY_BLOCKS=10000

# Bounty payments start in Nil, which gives the exact amount to send. Days that amount stays good,
# long enough for a multisig to collect its signatures.
# PAYMENT_INTENT_DAYS=14

# Days a bounty payment that was cancelled while stuck is still watched, so that if its
# transaction lands after all, it is counted.
# PAYMENT_WATCH_DAYS=7

# Hours a bounty payment, a Nil Pro payment or invoice, or the pass and staking checks may stay
# unsettled past their normal life before the billing watchdog tells the owners and admins in the
# app, warns in the log and lists it in /healthz (hosted Nil alerts the operator from there).
# PAYMENT_STALL_HOURS=6

# Block explorer used for transaction and address links in the app, as an http or https address.
# Links open only when clicked. The proof verifier links a payment receipt to it only when the
# receipt's chain is NOX_CHAIN_ID.
# NOX_EXPLORER=https://etherscan.io


# ---------------------------------------------------------------------------------------------
# Nil's verifier
# ---------------------------------------------------------------------------------------------
# A separate process from the same image, `node server/verifier/index.js` (npm run verifier),
# run once per server, never inside the app. It is a Helios light client: it follows the beacon
# chain from a checkpoint you trust, checks every answer from the execution node against the
# chain the sync committee signed, and seals what it proved for the app (NOX_VERIFIER_MODE). It
# reads only these settings. Helios is unaudited, and a lying node can still leave a log out of
# an answer: docs/self-hosting.md, "Verified chain reads", says what that means.

# The execution node it checks. It must answer eth_getProof for recent blocks (Reth with
# --rpc.eth-proof-window, Geth, Nethermind; ethereum-rpc.publicnode.com doesn't). Required.
# VERIFIER_EXECUTION_RPC=http://reth:8545

# A beacon node API with the light-client endpoints: your own Lighthouse with --http,
# or a public one. It can make the verifier fall behind, never accept a false answer. Required.
# VERIFIER_CONSENSUS_RPC=http://lighthouse:5052

# mainnet, sepolia or hoodi. NOX_CHAIN_ID in the app must match.
# VERIFIER_NETWORK=mainnet

# The root of a finalized beacon block, the one thing the verifier takes on trust. Take it from
# two beacon APIs run by different people that agree (.data.root of /eth/v1/beacon/headers/finalized).
# After its first start the verifier keeps the newest checkpoint it reached in VERIFIER_DATA_DIR.
# VERIFIER_CHECKPOINT=

# Days a checkpoint may be old before the verifier refuses it. Strict: it never starts from an
# older one. At most 14, the weak-subjectivity period's safe side on mainnet.
# VERIFIER_CHECKPOINT_MAX_AGE_DAYS=14

# The key it seals answers with, the app's NOX_VERIFIER_KEY. Required.
# VERIFIER_KEY=

# Where it listens. Keep it off the internet: only Nil servers should reach it.
# VERIFIER_HOST=0.0.0.0
# VERIFIER_PORT=8545

# Where it keeps the newest checkpoint (a single block root). Defaults to verifier/ in DATA_DIR.
# VERIFIER_DATA_DIR=

# Seconds one proof may take before it answers "couldn't verify in time". Keep it under
# NOX_RPC_TIMEOUT_SECONDS and SIGNIN_CHAIN_TIMEOUT_SECONDS.
# VERIFIER_TIMEOUT_SECONDS=7

# Seconds its newest block may be old before it answers nothing, so a light client that lost its
# consensus node never serves stale state.
# VERIFIER_MAX_HEAD_AGE_SECONDS=120

# Seconds between attempts to start the light client after a failure (checkpoint too old,
# consensus node down).
# VERIFIER_RETRY_SECONDS=30

# Proofs it works on at once; beyond that it answers "busy" rather than queueing.
# VERIFIER_MAX_REQUESTS=64

# Largest request it reads, in KB.
# VERIFIER_MAX_BODY_KB=256


# ---------------------------------------------------------------------------------------------
# Bounty reward tokens
# ---------------------------------------------------------------------------------------------

# Tokens bounties can be paid in besides NOX, as SYMBOL:address:decimals, comma separated.
# NOX is always first and can't be removed. An entry with a bad address is left out, with a
# startup warning.
# The default is USDC on Ethereum mainnet: change it if NOX_CHAIN_ID is not 1.
# Set to "none" to pay bounties in NOX only. Empty means the default, not "none".
# REWARD_TOKENS=USDC:0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48:6


# ---------------------------------------------------------------------------------------------
# Public bounty board
# ---------------------------------------------------------------------------------------------
# Anyone with a wallet can apply for a listed bounty, and wallets cost nothing, so these keep a
# flood of applications from burying one. Only applications still waiting for the team count:
# declined and deleted ones don't.

# Applications that can wait on one bounty at a time.
# BOUNTY_MAX_PENDING_APPLICATIONS=100

# Applications one wallet can have waiting on this server, across all bounties.
# BOUNTY_APPLICATIONS_PER_WALLET=5

# New applications one bounty takes in an hour.
# BOUNTY_APPLICATIONS_PER_HOUR=20


# ---------------------------------------------------------------------------------------------
# Nil Pro (optional)
# ---------------------------------------------------------------------------------------------
# With PLAN_TREASURY unset, the server runs in community mode: every tool is unlocked and
# nothing is charged. That is the normal choice for self-hosting. Set a treasury only if you run
# Nil for others and want each workspace to pay.
#
# Prices are in US dollars. An admin makes an invoice and pays it in USDC at face value, or in
# NOX at a discount, from any wallet or exchange. Each amount asked for ends in a short suffix
# that identifies the invoice, and the server watches the treasury's incoming transfers for it.

# Address that receives Nil Pro payments. It must be a valid 0x address. Anything else is
# ignored with a startup warning, and the server stays in community mode.
# PLAN_TREASURY=

# How the treasury is named in the app, e.g. "the NØNOS foundation treasury".
# PLAN_TREASURY_NAME=the treasury

# Flat price per period, in US dollars (up to 6 decimals, e.g. 12.50). Above zero.
# PLAN_PRICE_USD=12

# Price per person above PLAN_FREE_SEATS, per period, in US dollars. Guests never count.
# PLAN_SEAT_USD=3

# People (not counting guests) a workspace can have without Nil Pro.
# PLAN_FREE_SEATS=5

# Length of one paid period, in days.
# PLAN_PERIOD_DAYS=30

# Most periods one invoice can buy.
# PLAN_MAX_PERIODS=24

# Days the paid tools keep working after Nil Pro runs out.
# PLAN_GRACE_DAYS=7

# Free trial, in days, counted from when the first workspace appeared on this server. Its last
# PLAN_TRIAL_GRACE_DAYS count as the grace period, so trial and grace together last exactly this
# long. Erasing the workspace or restoring a capsule never starts a second trial. 0 means no trial.
# PLAN_TRIAL_DAYS=14

# Days at the end of the trial shown as its grace period. Unset, it's PLAN_GRACE_DAYS. Set it to
# 0 for a short trial, say PLAN_TRIAL_DAYS=2, that is all trial and then simply ends.
# PLAN_TRIAL_GRACE_DAYS=

# No longer read: Nil Pro is priced in US dollars (PLAN_PRICE_USD, PLAN_SEAT_USD).
# PLAN_PRICE=

# --- Tokens and prices

# USDC contract, paid at face value. "off" takes USDC payments away. On a chain other than
# mainnet, set it yourself.
# PLAN_USDC=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
# PLAN_USDC_DECIMALS=6

# Percent off when paying in NOX instead of USDC.
# PLAN_NOX_DISCOUNT=20

# NOX is priced on-chain: the time-weighted average price of a NOX/WETH pool, times Chainlink's
# ETH/USD feed. The rate an invoice uses is locked into it. The pool may be a Uniswap V2 pair or a
# V3 pool; the server tells which by asking it. NOX trades on the V2 pair
# 0x07ce5889d2eb681af3bd61db24ab2602c502bd1b. A V2 pair keeps no price history, so the server
# records it every JOB_POOL_PRICE_SECONDS (60) and only uses the average once a whole
# PLAN_TWAP_MINUTES window is recorded; until then PLAN_NOX_USD is used. The pair is thin, so keep
# the bounds below close to the market. Leave PLAN_NOX_POOL empty to use PLAN_NOX_USD alone.
# PLAN_NOX_POOL=
# PLAN_WETH=0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
# PLAN_ETH_USD_FEED=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419

# Minutes the pool's average covers, and how old the feed's answer may be.
# PLAN_TWAP_MINUTES=30
# PLAN_FEED_MAX_AGE_MINUTES=120

# A V2 pair's window is cut into this many stretches, and the price is the median of their
# averages, so a spike bought and sold back within a block or two moves nothing.
# PLAN_TWAP_PARTS=6

# Sanity bounds for the on-chain price, in US dollars per NOX. An answer outside them, a stale
# feed or a pool that can't answer falls back to PLAN_NOX_USD. Set them close to the market.
# PLAN_NOX_USD_MIN=0.000001
# PLAN_NOX_USD_MAX=1000

# Manual NOX price in US dollars, used when the on-chain price isn't usable. With neither,
# invoices can be paid in USDC only.
# PLAN_NOX_USD=

# --- NOX perks

# Workspaces whose owner or an admin holds a Zero-State Pass in a linked wallet get Nil Pro.
# Passes and stakes are checked at a random moment between half of PLAN_PERK_CHECK_HOURS and all
# of it after the last check. A pass gives Pro once the checks have kept finding it for
# PLAN_PERK_CHECK_HOURS, and Pro ends, with no grace period, at the first check that doesn't.
# PRO_FOR_ZSP=true
# PLAN_PERK_CHECK_HOURS=6

# Discount for admins who stake NOX in the official staking contract, as stake:percent pairs.
# The highest tier any one admin reaches applies, once the checks have kept seeing it there for
# PLAN_PERK_CHECK_HOURS and it's still there when the invoice is made. "none" turns it off.
# PLAN_STAKER_TIERS=10000:10,100000:25

# Percent of Nil Pro revenue that buys NOX and burns it, as published by whoever runs the
# treasury. The app shows it next to what the workspace paid. 0 shows no burn policy.
# BURN_SHARE=0

# Where the burns are published, opened only when someone clicks it. http or https.
# BURN_REPORT_URL=

# Days before Pro runs out that the owners and admins are reminded, comma separated.
# PLAN_REMIND_DAYS=7,1

# --- Invoices

# Hours an invoice can be paid in. A payment that arrives later becomes credit for the next one.
# PLAN_INVOICE_HOURS=24

# Days after an invoice expires that late payments to it are still matched (and credited). Also
# how long a payment that left the chain is looked for before its invoice may expire.
# PLAN_LATE_DAYS=7

# The reconciliation: every PLAN_RECONCILE_MINUTES, the treasury's transfers in the last
# PLAN_RECONCILE_BLOCKS blocks are read again whatever the scan already did, and payments given up
# on in the last PLAN_RECONCILE_DAYS are looked up again, so a missed or lagged transfer is always
# picked up. The block window stays inside NOX_LOG_HISTORY_BLOCKS.
# PLAN_RECONCILE_MINUTES=60
# PLAN_RECONCILE_BLOCKS=7200
# PLAN_RECONCILE_DAYS=30

# Most invoices one workspace can make in a day.
# PLAN_INVOICES_PER_DAY=10

# Digits in the suffix every asked amount ends with, and the most decimal places an asked amount
# uses (exchanges often refuse more than 8). With the defaults a USDC amount looks like 12.004817
# and a NOX amount like 160.00004817.
# Invoices and payments already made keep the layout they were made with.
# PLAN_SUFFIX_DIGITS=4
# PLAN_AMOUNT_DECIMALS=8

# Blocks of treasury transfers asked for in one eth_getLogs request. Lower it if your node limits
# the range of one request. How far back the node answers at all is NOX_LOG_HISTORY_BLOCKS.
# PLAN_LOG_BLOCKS=2000

# For hosts that run several workspaces against one treasury: give each server its own slot,
# as index/count (e.g. 3/50), and every server the same long random PLAN_INVOICE_KEY. Each
# server then draws suffixes from its own share, so no two workspaces can ever be asked for the
# same amount, and under- and overpayments from any wallet can be matched too. The key shuffles
# the shares, so the treasury's public transfers don't show which payments came from the same
# workspace. If one server alone uses the treasury, set PLAN_INVOICE_SLOT=0/1.
# Without a slot, only exact amounts are matched automatically.
# PLAN_INVOICE_SLOT=
# PLAN_INVOICE_KEY=


# ---------------------------------------------------------------------------------------------
# Token-holder door
# ---------------------------------------------------------------------------------------------
# Admins can let anyone holding enough NOX join without an invite. NOX held, NOX staked and
# Zero-State Passes all count.

# What one Zero-State Pass counts as, in whole NOX.
# HOLDER_ZSP_NOX=100000

# Hours between checks of members who joined as holders. They are also checked at every sign-in
# and whenever someone new joins the same way.
# HOLDER_RECHECK_HOURS=6

# Days a member who falls below the minimum keeps full access, after a notice, before they are
# signed out. 0 signs them out at the first check.
# HOLDER_GRACE_DAYS=3


# ---------------------------------------------------------------------------------------------
# Private payouts (ERC-5564 stealth addresses)
# ---------------------------------------------------------------------------------------------

# ERC-5564 announcer contract. The default is the standard's singleton, the same address on
# every chain it is deployed to.
# STEALTH_ANNOUNCER=0x55649E01B5Df198D18D95b5cc5051630cfD45564

# ERC-6538 registry, where a wallet can publish its meta-address so anyone can pay it privately.
# When someone hasn't turned private payouts on in Nil, the server looks their wallet up here.
# The default is the standard's singleton, the same address on every chain it is deployed to.
# "off" leaves the registry out.
# STEALTH_REGISTRY=0x6538E6bf4B0eBd30A8Ea093027Ac2422ce5d6538

# Seconds a meta-address read from the registry is reused before it is read again.
# STEALTH_REGISTRY_CACHE_SECONDS=300

# ETH, in wei, the payer sends along with each private payout so the contributor can pay gas
# from the one-time address. Default 300000000000000 wei = 0.0003 ETH. Digits only.
# STEALTH_GAS_TOPUP_WEI=300000000000000

# The least tip, in wei, a move out of a one-time address offers. The node's suggestion is used
# when it's higher. Some nodes suggest a tip of 0 when blocks have room, and a transaction that
# tips nothing may never be included. Default 50000000 wei = 0.05 gwei. Digits only.
# STEALTH_MIN_TIP_WEI=50000000

# How many days a confirmed private payout keeps being checked for a late announcement.
# STEALTH_ANNOUNCE_CHECK_DAYS=7

# The window, in seconds, over which payout balances are read. Each one-time address is read on
# its own at a random moment in the window, with another payee's address read at another moment,
# so the Ethereum node can't group one person's addresses by timing. The payee sees the last
# balance read and when; moving a payout reads that one address right away.
# STEALTH_BALANCE_SPREAD_SECONDS=1800

# Private bounty payouts through Privacy Pools by 0xbow. The team deposits into a pool from its
# wallet, and pays a bounty as a relayed withdrawal to the contributor's one-time address, so the
# chain doesn't link the team's wallet to the contributor. Off by default. It needs on-chain
# features on, and works on the chain in NOX_CHAIN_ID only. See docs/private-payouts.md.
# PRIVACY_POOLS=false

# mainnet or sepolia. The default follows NOX_CHAIN_ID; a value that doesn't match it keeps
# private pool payouts off.
# PRIVACY_POOLS_NETWORK=

# The Privacy Pools entry contract. Defaults: mainnet 0x6818809EefCe719E480a7526D76bD3e561526b46,
# Sepolia 0x34A2068192b1297f2a7f85D7D8CdE66F8F0921cB.
# PRIVACY_POOLS_ENTRYPOINT=

# Pools to use per reward token, as SYMBOL:poolAddress pairs, comma separated. Each must match
# the pool the entry contract reports for that token, or the token can't be paid privately. A
# token with no pool here and no network default uses whatever pool the entry contract lists for
# it, so NOX works the day 0xbow lists it. Mainnet defaults cover USDC, USDT, DAI, WBTC, wstETH,
# USDS and sUSDS by token address.
# PRIVACY_POOLS_POOLS=

# The relayer that sends withdrawals, so the team's wallet never does. Required on mainnet, which
# has no default. Sepolia default: https://testnet-relayer.privacypools.com. Only the Nil server
# talks to it, on browsers' behalf; it sees each payout's one-time address and amount, and this
# server's IP.
# PRIVACY_POOLS_RELAYER_URL=

# The association set provider, which decides which deposits may leave the pool privately.
# Defaults: mainnet https://api.0xbow.io, Sepolia https://dw.0xbow.io.
# PRIVACY_POOLS_ASP_URL=

# Ask the relayer to turn part of its fee into a little ETH at the one-time address, so the
# contributor can move the tokens. The fee shown before paying includes it.
# PRIVACY_POOLS_EXTRA_GAS=true

# Seconds to wait for the relayer or the association set provider.
# PRIVACY_POOLS_TIMEOUT_SECONDS=15

# Seconds to wait for the relayer to send a withdrawal. It answers once the transaction is out,
# and with extra gas only once it's mined. If it takes longer, or answers with an error, the
# payout may still have gone out: Nil looks for it on-chain, and an admin can have it look again
# later with Check for the payout on the deposit.
# PRIVACY_POOLS_RELAY_TIMEOUT_SECONDS=180

# The largest answer, in MB, taken from the relayer or the association set provider.
# PRIVACY_POOLS_MAX_RESPONSE_MB=16

# How long, in seconds, one read of a pool's association set and tree serves every admin.
# PRIVACY_POOLS_SETS_CACHE_SECONDS=60

# Blocks per request when a browser rebuilds the team's pool notes from the chain.
# PRIVACY_POOLS_LOG_RANGE_BLOCKS=10000

# Blocks per request when Nil looks on-chain for a payout the relayer didn't confirm. It reads
# from when the payout was started to the head, within the node's log history. Lower it if your
# node limits the range of one eth_getLogs request.
# PRIVACY_POOLS_SEARCH_BLOCKS=2000


# ---------------------------------------------------------------------------------------------
# Voting power
# ---------------------------------------------------------------------------------------------
# Power = NOX in linked wallets + NOX staked + Zero-State Passes (ZSPs) × power per ZSP,
# read at one block when a weighted vote opens.

# Staking contract read with getStakeInfo(address). "off" leaves staked NOX out.
# NOX_STAKING=0xa94d6009790Ba13597A1E1b7cF4e1531eA513613

# Zero-State Pass contract read with balanceOf(address). "off" leaves ZSPs out.
# ZSP_CONTRACT=0x7b575dd8e8b111c52ab1e872924d4efd4df403df

# Default voting power per ZSP, in whole NOX. Admins can change it per workspace in
# Settings → Team → Voting power. Digits only.
# VOTE_ZSP_POWER=100000

# Public votes, which every NOX holder can sign on a page of their own. off hides and refuses them,
# so only the workspace's own votes remain. Hosted Nil sets off for every workspace except the
# ones its operator marks official.
# PUBLIC_VOTES=on


# ---------------------------------------------------------------------------------------------
# Anonymous votes (Semaphore)
# ---------------------------------------------------------------------------------------------

# Depth of the Semaphore voter tree: up to 2^depth voters per vote (16 = 65,536).
# The browser loads client/public/zk/semaphore-<depth>.wasm and .zkey, and only depth 16 ships.
# To change it, run  SEMAPHORE_DEPTH=<n> npm run zk:fetch  before building (or building the
# Docker image), and change it only while no anonymous vote is open.
# Encrypted weighted votes use their own circuit, which is fixed at depth 16.
# SEMAPHORE_DEPTH=16


# ---------------------------------------------------------------------------------------------
# Built-in AI (optional)
# ---------------------------------------------------------------------------------------------
# Each workspace brings its own key: an admin picks Anthropic (Claude), OpenAI (GPT) or any
# OpenAI-compatible provider in Settings → Connect AI and pastes a key from that provider. It is
# sealed in the data folder and never shown again. Nothing here is needed for that. Text goes to
# the provider only when someone clicks an AI button. Connecting your own assistant over MCP
# works either way.

# A default for a server you run yourself: every workspace without a provider of its own uses
# this Anthropic key. Built-in AI turns on with the default when this and ANTHROPIC_MODEL are
# both set. Hosted Nil sets none of these.
# ANTHROPIC_API_KEY=

# Alternative to the API key, for the default only: a bearer token for the Anthropic API.
# ANTHROPIC_AUTH_TOKEN=

# The Anthropic model the default uses, by the name Anthropic lists it under. There is no
# default: with a key but no model, the default stays off and the startup log says so.
# ANTHROPIC_MODEL=

# The Anthropic SDK reads ANTHROPIC_BASE_URL for the default, if you need to send its requests
# through another endpoint. It never applies to a workspace's own key.
# ANTHROPIC_BASE_URL=

# Where requests with a workspace's own Anthropic or OpenAI key go. An OpenAI-compatible provider
# brings its own address. Every such request gets the same address checks as agents' endpoints
# (AGENT_ALLOW_LOCAL_ENDPOINTS) and goes through EGRESS_PROXY when that is set.
# AI_ANTHROPIC_URL=https://api.anthropic.com
# AI_OPENAI_URL=https://api.openai.com/v1

# The most tokens one built-in AI answer may use, sent to the provider with every request.
# AI_MAX_OUTPUT_TOKENS=16000

# Seconds one AI request may take before it is given up, and how many times a Claude request that
# hit a rate limit, an outage or this timeout is tried again. Someone is waiting on each request,
# so the longest wait is AI_TIMEOUT_SECONDS × (AI_MAX_RETRIES + 1).
# AI_TIMEOUT_SECONDS=120
# AI_MAX_RETRIES=1

# Built-in AI requests one person may make a minute, and a day. The daily number is also how
# many anonymous requests each member gets per UTC day (see below); at most 1000.
# AI_REQUESTS_PER_MINUTE=12
# AI_REQUESTS_PER_DAY=100

# Anonymous AI requests. Members with a voting key prove they belong to the workspace without
# saying who they are (Settings → Connect AI has the switch). A proof is made against the member
# list; after the list changes, the last AI_CREDIT_ROOTS lists stay good for
# AI_CREDIT_ROOT_MINUTES, unless someone on them has left. The server can't tell members apart
# here, so the only per-caller limit is by IP address. Admins see a count per day, kept
# AI_CREDIT_USAGE_DAYS days; nothing else about these requests outlives its UTC day.
# AI_CREDIT_ROOT_MINUTES=10
# AI_CREDIT_ROOTS=4
# AI_CREDIT_PER_ADDRESS_PER_MINUTE=60
# AI_CREDIT_USAGE_DAYS=30


# ---------------------------------------------------------------------------------------------
# Agents (optional)
# ---------------------------------------------------------------------------------------------
# AI teammates added in Settings → Agents. External agents connect over /mcp or the REST API at
# /api/agent/v1 with their own key and need nothing here. Built-in agents run inside Nil, on the
# workspace's provider from Settings → Connect AI, on Anthropic with a key of their own (or the
# workspace's or the default above), or on an OpenAI-compatible endpoint such as a local model.
# Each limit below is a workspace default; admins can change it per agent.
# See docs/ai-agents.md.

# Model for built-in agents on Anthropic, after the workspace's own Claude model. Unset means
# ANTHROPIC_MODEL; with none of these, each agent on Anthropic needs its own model, entered in
# Settings → Agents.
# AGENT_MODEL=

# Effort for Anthropic runs: low, medium, high, xhigh or max. "off" leaves it out, for models
# that don't take it.
# AGENT_EFFORT=high

# "off" stops sending the adaptive thinking setting, for older models that reject it.
# AGENT_THINKING=adaptive

# "default" asks Anthropic to re-run a request its model declines on another model it picks
# (server-side fallbacks). Off unless set. A model or account that doesn't take it gets the
# request again without it, and the log says so.
# AGENT_FALLBACKS=off

# Model turns one run may take before it stops and says so.
# AGENT_MAX_STEPS=12

# Tokens (input and output together) one run may use, and one agent may use per day.
# AGENT_MAX_TOKENS_PER_RUN=300000
# AGENT_MAX_TOKENS_PER_DAY=3000000

# Longest single model answer, in tokens.
# AGENT_MAX_OUTPUT_TOKENS=32000

# Wall-clock limit for one run, in seconds.
# AGENT_RUN_TIMEOUT_SECONDS=600

# Runs at the same time, across all agents.
# AGENT_CONCURRENCY=2

# Retries after a transient model error (rate limit, overloaded or unreachable API).
# AGENT_RETRIES=3

# How often the run queue and the webhook queue are checked, in seconds. New work starts at
# once anyway; this catches retries whose wait is over.
# AGENT_POLL_SECONDS=5

# Where a built-in agent moves assigned work it finished: a status (backlog, todo, in_progress,
# in_review, done, canceled) or "none" to leave it.
# AGENT_DONE_STATUS=in_review

# Requests a minute per agent key on /mcp and /api/agent/v1.
# AGENT_RATE_LIMIT=60

# Hours an Idempotency-Key on the REST API is remembered, or less when the retention settings
# for comments or history are shorter.
# AGENT_IDEMPOTENCY_HOURS=24

# An agent changing more than this many tasks within the window needs a person's approval.
# AGENT_BULK_LIMIT=5
# AGENT_BULK_WINDOW_MINUTES=10

# Requests one agent may have waiting for approval at a time. Past this, its next request that
# needs approval is refused until people have decided some.
# AGENT_MAX_PENDING_APPROVALS=20

# Lets webhooks and model endpoints use loopback and private addresses (and plain http), for an
# agent or model on your own machine or network, such as Ollama on localhost. Link-local and
# cloud metadata addresses stay blocked. Leave it off on a server others can configure.
# AGENT_ALLOW_LOCAL_ENDPOINTS=false

# off on a server with no route out to the internet: the app then doesn't offer built-in agents on
# an OpenAI-compatible endpoint or webhooks, which could never reach their address. Hosted Nil sets
# it for every workspace that has no egress proxy.
# AGENT_OUTBOUND=on

# An http:// CONNECT proxy for every outbound request (webhooks, model endpoints, AI providers),
# for a server whose network has no route out of its own. Requests are still checked and pinned
# to one address here, and stay https inside the tunnel, so the proxy sees an address and a port
# and nothing else. Plain http targets are refused. Hosted Nil sets it when its egress proxy is on.
# EGRESS_PROXY=

# How much of an error answer from a model endpoint or AI provider is kept, in KB, when it isn't
# a stream. Streams themselves are never capped.
# AGENT_ERROR_BODY_KB=1024

# Webhook deliveries: how long to wait for an answer, how many attempts per delivery, the first
# retry delay (doubling each time, with jitter), and how many failed attempts in a row switch a
# webhook off.
# AGENT_WEBHOOK_TIMEOUT_SECONDS=10
# AGENT_WEBHOOK_MAX_ATTEMPTS=8
# AGENT_WEBHOOK_BACKOFF_SECONDS=30
# AGENT_WEBHOOK_DISABLE_AFTER=20

# Days a finished webhook delivery (delivered, failed or canceled) stays in the delivery log.
# AGENT_WEBHOOK_LOG_DAYS=30

# The replay window receivers should apply to Nil-Timestamp, shown in Settings and the docs.
# AGENT_WEBHOOK_TOLERANCE_SECONDS=300

# Hours ahead a task.due_soon webhook is sent for work assigned to an agent.
# AGENT_DUE_SOON_HOURS=24

# Dollars per million input and output tokens for agents on Anthropic, only for the cost
# estimate in Settings. Unset means no estimate: Settings shows token counts only. Agents on
# other endpoints take their prices on the agent.
# AGENT_PRICE_INPUT_PER_MTOK=
# AGENT_PRICE_OUTPUT_PER_MTOK=


# ---------------------------------------------------------------------------------------------
# Not read by the server
# ---------------------------------------------------------------------------------------------
# These are used only by development tools and npm scripts, and they don't load .env.
# Set them in your shell when you run the command.
#
#   NONOS_API      npm run dev: where the Vite dev server sends /api and /ws (default http://localhost:3000)
#   PTAU           npm run zk:ballot: path to the Perpetual Powers of Tau file (ppot_0080_16.ptau)
#   BEACON_RPC     npm run zk:ballot: Ethereum node for the beacon block hash (default the public node above)
#   CONTRIBUTORS   npm run zk:ballot: number of phase-2 contributions (default 2, all on this machine)
