# The settings the NØNOS foundation runs its own hosted Nil with, as far as they're public.
# Copy what you need into /opt/nil/cloud.env on the server. Secrets (CLOUD_INVOICE_KEY, backup
# keys, the alert webhook) live only there, never in this repository.
#
# Running Nil yourself? Use your own treasury, or none at all for community mode: anything you
# copy from here sends your customers' payments to the NØNOS treasury.

# Nil Pro payments go to the NØNOS treasury, a Safe that needs three signatures to move funds.
CLOUD_PLAN_TREASURY=0xC4155a7bcE81a5DFE03919eF81A02a44f30Cfbee

# Unclaimed workspaces go after 30 days; claimed ones are never removed for being quiet.
CLOUD_UNCLAIMED_DAYS=30
CLOUD_IDLE_DAYS=0

# Phone wallets on the sign-up page. The foundation's project ID is set on the server, in this
# file and in workspace.env, and is kept out of the repository so a copy of these settings
# never borrows it.
# WALLETCONNECT_PROJECT_ID=
