# Hosted Nil control plane settings. On the server: /opt/nil/cloud.env, mode 600.
#
# A commented-out line shows the default. An empty value counts as unset. Settings that can't be
# used are named in a "[config]" line at startup; missing required ones stop the control plane
# with a list of everything to fix. docker-compose.yml sets the container paths, ports and the
# app image itself (CLOUD_APP_IMAGE, CLOUD_DATA_DIR, CLOUD_CADDYFILE, CLOUD_CADDY_CONTAINER,
# CLOUD_PORT, CLOUD_INTERNAL_PORT, CLOUD_TRUST_PROXY, CLOUD_APP_ENV_FILE): leave those out here.


# ---------------------------------------------------------------------------------------------
# Addresses (required)
# ---------------------------------------------------------------------------------------------

# Workspaces live at <name>.CLOUD_DOMAIN. Point an A (and AAAA) record for the domain and a
# wildcard record *.CLOUD_DOMAIN at this server.
CLOUD_DOMAIN=

# Where the sign-up page lives. Default: CLOUD_DOMAIN itself.
# CLOUD_SIGNUP_HOST=

# Email Let's Encrypt and ZeroSSL use for expiry notices. Recommended.
CLOUD_ACME_EMAIL=

# Shown on the sign-up page and on the notice of a paused workspace: an email address or URL.
CLOUD_CONTACT=

# Links in the sign-up page footer. A hosted service in Germany or Finland needs at least an
# imprint and a privacy policy. With CLOUD_TERMS_URL set, the wallet message people sign says
# they accept those terms.
CLOUD_TERMS_URL=
CLOUD_PRIVACY_URL=
CLOUD_IMPRINT_URL=

# Where people can get the source of what you run. The AGPL asks a hosted service to offer it.
# Passed to every workspace as SOURCE_URL.
CLOUD_SOURCE_URL=


# ---------------------------------------------------------------------------------------------
# Workspaces
# ---------------------------------------------------------------------------------------------

# The foundation's treasury. Passed to every workspace as PLAN_TREASURY, so Nil Pro is billed
# inside each workspace. Empty means community mode everywhere: every tool unlocked, nothing billed.
CLOUD_PLAN_TREASURY=

# With a treasury, every workspace bills to the same address. Each one gets its own slot of the
# invoice amounts' last digits, so no two can ask for the same amount, and this shared secret
# shuffles the slots so the chain doesn't show which payments came from the same workspace.
# Make it with: openssl rand -hex 32. Keep it secret and never change it once billing runs.
CLOUD_INVOICE_KEY=
# How many workspaces can each have a slot. It has to fit in PLAN_SUFFIX_DIGITS in the workspace
# env file: 1000 slots work with the default 4 digits, more need PLAN_SUFFIX_DIGITS=6.
# CLOUD_INVOICE_SLOTS=1000

# Where workspaces send their chain lookups for payments, balances, stakes and passes. In
# shadow and off mode (below), the Ethereum node: your own (docker-compose.chain.yml gives you
# one, http://reth:8545) or a provider you trust. In enforce mode, Nil's verifier in front of it:
# http://verifier:8545. "off" turns on-chain features and billing off. Required.
CLOUD_RPC_URL=

# How workspaces use Nil's verifier (docker-compose.verifier.yml), as NOX_VERIFIER_MODE:
# shadow: they act on CLOUD_RPC_URL as before, and every answer is checked through the verifier
#   on the side. A proven lie shows admins a notice and sends you a critical alert
#   (workspace.chain_mismatch); nothing waits. The launch default.
# enforce: they act only on answers the verifier proved, and wait when it can't verify.
# off: no checks.
# Switch to enforce once the bundled node is synced and a week of shadow showed no mismatches.
# Shadow without VERIFIER_KEY or CLOUD_VERIFIER_URL is off, with a warning; enforce without the key
# doesn't start.
# CLOUD_VERIFIER_MODE=shadow

# Shadow mode: where the verifier answers. Workspaces reach it through Caddy's second relay.
# CLOUD_VERIFIER_URL=http://verifier:8545

# Port of that relay on the workspace networks. Never published on the host.
# CLOUD_VERIFIER_RELAY_PORT=8546

# The key the verifier seals its answers with, handed to every workspace as NOX_VERIFIER_KEY.
# Don't set it here: docker-compose.yml passes VERIFIER_KEY from /opt/nil/.env, so the verifier
# and the control plane always have the same one.
# CLOUD_VERIFIER_KEY=

# rpc-only: each workspace's network has no route out at all, and Caddy relays its JSON-RPC
# requests to CLOUD_RPC_URL. Nothing else leaves a workspace.
# open: workspaces can reach the internet (needed only if you give them an Anthropic API key in
# workspace.env, for example).
# CLOUD_EGRESS=rpc-only

# Port of Caddy's relay on the workspace networks. Never published on the host.
# CLOUD_RPC_RELAY_PORT=8545

# Resource plans: name:cpus=<cores>,memory=<size>,pids=<max processes>,disk=<size>; ...
# cpus, memory and pids are hard limits. Docker can't cap a volume's size, so disk is passed to
# each workspace as its upload quota (UPLOAD_QUOTA_MB), which the app enforces on uploads;
# past the plan a daily alert goes out, and past CLOUD_DISK_SUSPEND_PERCENT of it the workspace
# is suspended. The first plan is the default unless CLOUD_DEFAULT_PLAN says otherwise.
# CLOUD_PLANS=standard:cpus=1,memory=768m,pids=256,disk=5g;pro:cpus=2,memory=1536m,pids=512,disk=50g
# CLOUD_DEFAULT_PLAN=standard

# Each workspace runs as its own uid and gid: this number plus the workspace's slot, so 200000
# and up. Its volume is handed to that uid before its container starts. None of them is 1000,
# the control plane's uid, or the uid of any account on the host.
# 0 runs them all as 1000, as releases up to 3.0.0 did: set it, then `cli.js refresh --all`, only
# before rolling the control plane back to such a release, since that one runs workspaces as 1000.
# CLOUD_APP_UID_BASE=200000

# Size of each workspace's /tmp, in MB, held in memory.
# CLOUD_APP_TMPFS_MB=64

# Each workspace's container log: size of one file in MB, and how many files are kept.
# CLOUD_APP_LOG_MB=10
# CLOUD_APP_LOG_FILES=3

# How often Docker checks each workspace's /healthz, in seconds.
# CLOUD_APP_HEALTH_INTERVAL_SEC=30

# How long a workspace may take to become healthy after a start or upgrade, in seconds.
# CLOUD_START_TIMEOUT_SEC=120

# How long a workspace gets to shut down cleanly, in seconds.
# CLOUD_STOP_TIMEOUT_SEC=15

# Whether the control plane may pull an app image that isn't on this server: never, missing or
# always. deploy/release.sh loads images over SSH, so the default never pulls anything, and an
# image that isn't there stops the operation instead. Use missing only with images named on a
# registry the foundation controls (NIL_IMAGE in /opt/nil/.env, release.sh --registry).
# CLOUD_IMAGE_PULL=never

# Docker Engine API version. 1.44 is Docker 25 and later.
# CLOUD_DOCKER_API=1.44

# Docker refuses to remove a container, network or volume for a moment while it is still in
# use. Removals are tried this many times, waiting this long before the second try and twice as
# long before each one after it (about 15 seconds in all with these values).
# CLOUD_DOCKER_REMOVE_TRIES=6
# CLOUD_DOCKER_REMOVE_WAIT_MS=500


# ---------------------------------------------------------------------------------------------
# Sign-up and abuse limits
# ---------------------------------------------------------------------------------------------

# open or closed. Closed keeps the page up with a notice; the CLI can still create workspaces.
# CLOUD_SIGNUP=open

# Most workspaces this server holds. Sign-ups close when it is reached.
# CLOUD_MAX_WORKSPACES=300

# Workspaces one wallet may own, and create per day.
# CLOUD_MAX_PER_WALLET=3
# CLOUD_SIGNUPS_PER_WALLET_PER_DAY=2

# Sign-ups per network per day. A network is one IPv4 address or one IPv6 /56, the usual size
# of a home or office allocation, so rotating through the addresses of one connection doesn't
# help. Network counters are kept in memory only.
# CLOUD_SIGNUPS_PER_IP_PER_DAY=3

# Sign-ups per block, per day and per hour. A block is an IPv4 /24 or an IPv6 /48, so one
# provider's or one tunnel's addresses can't add up to more than their share. There is no budget
# shared by everyone, which one network could use up to close sign-ups for all.
# CLOUD_SIGNUPS_PER_BLOCK_PER_DAY=10
# CLOUD_SIGNUPS_PER_BLOCK_PER_HOUR=3

# Past this many new workspaces in a day, or once this share of CLOUD_MAX_WORKSPACES is in use,
# a signed sign-up waits for approval instead of starting at once. The person gets their setup
# code straight away; `cli.js requests` lists them, `approve` and `reject` decide. A request
# nobody approves is dropped after CLOUD_SIGNUP_REQUEST_DAYS.
# CLOUD_SIGNUPS_PER_DAY=100
# CLOUD_APPROVAL_ABOVE_PERCENT=90
# CLOUD_SIGNUP_REQUEST_DAYS=7

# Wallet challenges per network and per block per 15 minutes, and address lookups per network
# per minute. Challenges are sealed tokens the server doesn't store, so a flood of them can't
# push anyone else's out.
# CLOUD_CHALLENGES_PER_IP=20
# CLOUD_CHALLENGES_PER_BLOCK=60
# CLOUD_NAME_CHECKS_PER_IP=60

# Difficulty of the proof-of-work puzzle the browser solves, in bits (0 to 24). Each bit doubles
# the work: 16 is a second or two on a phone.
# CLOUD_POW_BITS=16

# Address length limits.
# CLOUD_NAME_MIN=3
# CLOUD_NAME_MAX=32

# More reserved addresses, comma separated, on top of the built-in list (www, admin, nonos…).
# CLOUD_RESERVED_NAMES=

# A file with more blocked words, one per line, refused anywhere in an address.
# CLOUD_BLOCKLIST_FILE=

# Days a deleted workspace's address stays unavailable to others.
# CLOUD_NAME_QUARANTINE_DAYS=90

# Days a new workspace may stay unclaimed (setup never finished) before it is removed. 0 keeps them.
# CLOUD_UNCLAIMED_DAYS=7

# Days a claimed workspace's data may go unchanged before it is paused. Its address then shows a
# notice with the date it will be deleted, CLOUD_IDLE_NOTICE_DAYS later, unless its owner asks
# for it back (`resume`). Deletion takes a final encrypted backup and waits out the usual grace
# period. "Unchanged" is read from the modification time of its database files, never their
# contents. 0 keeps every workspace. Say so in the terms.
# CLOUD_IDLE_DAYS=180
# CLOUD_IDLE_NOTICE_DAYS=30

# Minutes the sign-up page has to collect the setup code once the workspace is ready.
# CLOUD_TICKET_MINUTES=30

# Phone wallets on the sign-up page: on a computer without a wallet extension, "Use a wallet on
# your phone" shows a code to scan with the wallet app on the phone, which then signs the sign-up
# message. The project ID comes from the Reown (WalletConnect) dashboard, where the sign-up host
# must be on the project's allowed domains. It is public, not a secret: every browser that uses
# it sends it to the relay. Empty keeps the option off and the page's policy as strict as ever;
# set, the page may also connect to the relay, and only while someone uses a phone wallet. A
# value that isn't a project ID stops the start. Workspaces read the same name from their own
# environment file (CLOUD_APP_ENV_FILE), so set it there too for phone wallets inside them.
# WALLETCONNECT_PROJECT_ID=
# A relay of your own instead of WalletConnect's (wss://, no path). Rarely needed.
# WALLETCONNECT_RELAY_URL=


# ---------------------------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------------------------

# wildcard (use it for a public launch): one *.CLOUD_DOMAIN certificate through the DNS
# challenge. Needs a Caddy image with your DNS provider's module (cloud/caddy/Dockerfile) and
# DNS_API_TOKEN in /opt/nil/.env, or for OVHcloud's DNS the four OVH_ values there.
# on-demand: one certificate per workspace, issued at its first visit, only for addresses the
# control plane confirms. Works with the stock Caddy image, but Let's Encrypt allows 50 new
# certificates per registered domain per week, so a few dozen throwaway sign-ups would leave
# real workspaces without a certificate until the week is over.
# CLOUD_TLS=on-demand

# The Caddy DNS module's name, for wildcard: hetzner, cloudflare, ovh, desec…
# CLOUD_DNS_PROVIDER=

# Minutes open WebSocket connections are kept when Caddy reloads (every sign-up reloads it).
# CLOUD_STREAM_CLOSE_DELAY_MIN=5


# ---------------------------------------------------------------------------------------------
# Lifecycle
# ---------------------------------------------------------------------------------------------

# Days between `delete` and the data being erased. `resume` cancels during that time.
# CLOUD_DELETE_GRACE_DAYS=14

# A rolling upgrade stops once more than this many workspaces failed (and were rolled back).
# CLOUD_UPGRADE_MAX_FAILURES=1

# Days the pre-upgrade checkpoint is kept for a manual rollback before it is erased.
# CLOUD_CHECKPOINT_KEEP_DAYS=7

# A backup, an upgrade, a rollback or a restore of one workspace never run at the same time.
# Seconds one waits for another to finish before giving up (an upgrade then skips that
# workspace), and seconds a lock lasts if the process holding it dies (renewed while it works).
# CLOUD_LOCK_WAIT_SEC=900
# CLOUD_LOCK_LEASE_SEC=300


# ---------------------------------------------------------------------------------------------
# Backups
# ---------------------------------------------------------------------------------------------

# Public keys backups are encrypted to, comma separated (nilbk-pub-…). Make a key pair on a
# machine you trust with `node cloud/cli.js keygen --out backup.key` and keep the secret key
# offline. List two keys held by two people, so one lost key loses nothing.
CLOUD_BACKUP_RECIPIENTS=

# file:///backups (the share mounted at NIL_BACKUP_DIR on the host, such as a Hetzner Storage
# Box) or s3://bucket/prefix with the CLOUD_S3_* settings below.
CLOUD_BACKUP_TARGET=

# When the nightly backup runs, HH:MM in UTC, or off.
# CLOUD_BACKUP_TIME=03:15

# Days backups are kept in a file target. For S3 use a lifecycle rule on the bucket instead.
# For S3 it is also the shortest Object Lock retention the startup check accepts.
# CLOUD_BACKUP_KEEP_DAYS=30

# S3-compatible storage, for an s3:// target. The bucket needs versioning and Object Lock in
# compliance mode, or a key stolen from this server could overwrite and delete every backup; the
# control plane checks both at startup and alerts. A file target needs snapshots the server can't
# delete instead, such as a Storage Box's (see cloud/README.md, step 4).
# CLOUD_S3_ENDPOINT=https://hel1.your-objectstorage.com
# CLOUD_S3_REGION=hel1
# CLOUD_S3_ACCESS_KEY_ID=
# CLOUD_S3_SECRET_ACCESS_KEY=
# CLOUD_S3_PART_MB=16


# ---------------------------------------------------------------------------------------------
# Health and alerts
# ---------------------------------------------------------------------------------------------

# Where alerts are posted, as JSON with a "text" field (Slack, Mattermost, a Matrix hook, ntfy…).
CLOUD_ALERT_WEBHOOK=

# Sent as "Authorization: Bearer <token>" when set.
# CLOUD_ALERT_TOKEN=

# Telegram, as well as or instead of the webhook: a bot token from @BotFather and the chat it
# posts in (a group's id is a negative number). Add the bot to a private group of operators only.
# The token is a secret: anyone holding it can post as the bot.
# CLOUD_ALERT_TELEGRAM_TOKEN=
# CLOUD_ALERT_TELEGRAM_CHAT=

# Minutes before the same alert about the same workspace is sent again.
# CLOUD_ALERT_REPEAT_MIN=30

# Seconds between health checks, failed checks in a row before a restart, and restarts per hour
# before automatic restarts pause for that workspace.
# CLOUD_HEALTH_INTERVAL_SEC=60
# CLOUD_HEALTH_FAILURES=3
# CLOUD_MAX_RESTARTS_PER_HOUR=3

# Alert when less than this share of the disk is free, in percent.
# CLOUD_DISK_FREE_ALERT_PERCENT=15

# Once an hour the control plane connects to the sign-up host (and, with CLOUD_TLS=wildcard, to a
# name under it) like a visitor and checks the certificate. It warns when fewer than
# CLOUD_CERT_WARN_DAYS are left and raises a critical alert under CLOUD_CERT_CRITICAL_DAYS or when
# the certificate doesn't verify. Caddy renews with a third of a certificate's life left, so with
# shorter certificates than Let's Encrypt's 90 days, lower both. 0 turns the check off. By default
# it connects to the address the names resolve to; CLOUD_CERT_CHECK_ADDRESS connects elsewhere
# (Caddy's container name, say) when this machine can't reach its own public address.
# CLOUD_CERT_WARN_DAYS=21
# CLOUD_CERT_CRITICAL_DAYS=7
# CLOUD_CERT_CHECK_ADDRESS=

# Minutes between usage measurements (disk per workspace) and setup-claim checks.
# CLOUD_USAGE_INTERVAL_MIN=15

# A workspace using more than this share of its plan's disk, in percent, is suspended with a
# critical alert, and its address tells visitors why. 0 only alerts. After a resume it gets
# CLOUD_DISK_RESUME_GRACE_HOURS to be cleaned up or resized before it is suspended again.
# CLOUD_DISK_SUSPEND_PERCENT=120
# CLOUD_DISK_RESUME_GRACE_HOURS=24

# The control plane's own log file: size of one file in MB, and how many are kept.
# CLOUD_LOG_FILE_MB=10
# CLOUD_LOG_FILES=5
